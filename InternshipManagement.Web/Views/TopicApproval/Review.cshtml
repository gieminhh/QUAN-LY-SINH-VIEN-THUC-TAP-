@model InternshipManagement.Web.ViewModels.TopicReviewViewModel
@{
    ViewData["Title"] = "Xét duyệt đề tài: " + Model.Topic.Code;
    var topic = Model.Topic;
}

<div class="page-container sprint2-page">
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <div>
            <a asp-action="Index" class="text-decoration-none text-muted small">
                <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách xét duyệt
            </a>
            <h4 class="fw-bold text-primary mt-2 mb-1">
                <i class="bi bi-clipboard2-check me-2"></i>XÉT DUYỆT ĐỀ TÀI: @topic.Code
            </h4>
            <div class="text-muted small">
                Tên đề tài: <strong>@topic.Title</strong> | 
                Đợt: <strong>@topic.Campaign?.Code - @topic.Campaign?.Name</strong>
            </div>
        </div>

        <div>
            <span class="@InternshipManagement.Web.Models.TopicStatuses.GetBadgeClass(topic.Status) fs-6 px-3 py-2">
                Trạng thái: @InternshipManagement.Web.Models.TopicStatuses.GetDisplayName(topic.Status)
            </span>
        </div>
    </div>

    <div class="row g-4">
        <!-- Cột trái: Thông tin đề tài & Lịch sử -->
        <div class="col-lg-8">
            <div class="card card-custom p-4 mb-4">
                <h5 class="fw-bold text-primary border-bottom pb-2 mb-3">
                    <i class="bi bi-card-text me-2"></i>Thông tin chi tiết đề tài
                </h5>

                <div class="mb-3">
                    <h6 class="fw-bold text-secondary">Mô tả tổng quan:</h6>
                    <p class="text-dark" style="white-space: pre-line;">@(string.IsNullOrWhiteSpace(topic.Description) ? "Chưa có mô tả." : topic.Description)</p>
                </div>

                <div class="mb-3">
                    <h6 class="fw-bold text-secondary">Mục tiêu đề tài:</h6>
                    <p class="text-dark" style="white-space: pre-line;">@(string.IsNullOrWhiteSpace(topic.Objectives) ? "Chưa có thông tin mục tiêu." : topic.Objectives)</p>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <h6 class="fw-bold text-secondary">Yêu cầu kiến thức:</h6>
                        <p class="text-dark" style="white-space: pre-line;">@(string.IsNullOrWhiteSpace(topic.KnowledgeRequirements) ? "Không có yêu cầu." : topic.KnowledgeRequirements)</p>
                    </div>
                    <div class="col-md-6">
                        <h6 class="fw-bold text-secondary">Công nghệ sử dụng:</h6>
                        <p class="text-dark" style="white-space: pre-line;">@(string.IsNullOrWhiteSpace(topic.Technologies) ? "Chưa chỉ định." : topic.Technologies)</p>
                    </div>
                </div>

                <div class="border-top pt-3">
                    <h6 class="fw-bold text-secondary mb-2">Đề cương / Tài liệu đính kèm:</h6>
                    @if (Model.DocumentAttachment != null)
                    {
                        <div class="d-flex align-items-center justify-content-between p-3 border rounded bg-light">
                            <div class="d-flex align-items-center gap-3">
                                <i class="bi bi-file-earmark-arrow-down fs-3 text-primary"></i>
                                <div>
                                    <div class="fw-bold">@Model.DocumentAttachment.OriginalFileName</div>
                                    <small class="text-muted">
                                        Dung lượng: @((Model.DocumentAttachment.SizeBytes / 1024.0).ToString("N1")) KB | 
                                        Tải lên: @Model.DocumentAttachment.UploadedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </small>
                                </div>
                            </div>
                            <a asp-controller="Topics" asp-action="DownloadDocument" asp-route-attachmentId="@Model.DocumentAttachment.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-download me-1"></i> Tải tài liệu
                            </a>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">Không có tài liệu đính kèm.</p>
                    }
                </div>
            </div>

            <!-- Lịch sử xét duyệt -->
            <div class="card card-custom">
                <div class="card-header-custom">
                    <i class="bi bi-clock-history me-2"></i>Lịch sử xét duyệt & phản hồi của hội đồng
                </div>
                <div class="card-body p-3">
                    @if (Model.Histories.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered small align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Thời gian</th>
                                        <th>Người thực hiện</th>
                                        <th>Hành động</th>
                                        <th>Trạng thái</th>
                                        <th>Ý kiến nhận xét / Phản hồi</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var h in Model.Histories)
                                    {
                                        <tr>
                                            <td style="white-space: nowrap;">@h.ActionAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                            <td class="fw-semibold">@(h.ActorUser?.FullName ?? h.ActorUserId)</td>
                                            <td>
                                                <span class="@InternshipManagement.Web.Models.TopicActionTypes.GetBadgeClass(h.ActionType)">
                                                    @InternshipManagement.Web.Models.TopicActionTypes.GetDisplayName(h.ActionType)
                                                </span>
                                            </td>
                                            <td>
                                                <span class="@InternshipManagement.Web.Models.TopicStatuses.GetBadgeClass(h.ToStatus)">
                                                    @InternshipManagement.Web.Models.TopicStatuses.GetDisplayName(h.ToStatus)
                                                </span>
                                            </td>
                                            <td class="text-wrap" style="max-width: 300px;">
                                                @(string.IsNullOrEmpty(h.CommentText) ? "--" : h.CommentText)
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small text-center mb-0 py-2">Chưa có lịch sử xét duyệt.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Cột phải: Bảng điều khiển xét duyệt (Actions) & Giảng viên -->
        <div class="col-lg-4">
            <!-- Action Panel xét duyệt (US-11) -->
            <div class="card card-custom p-4 mb-4 border-primary">
                <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                    <i class="bi bi-shield-check me-2"></i>Thao tác xét duyệt
                </h6>

                @if (topic.Status == InternshipManagement.Web.Models.TopicStatuses.Pending)
                {
                    <div class="mb-3">
                        <label for="reviewComments" class="form-label fw-semibold">
                            Ý kiến nhận xét / Lý do: <span class="text-danger">*</span>
                        </label>
                        <textarea id="reviewComments" class="form-control" rows="4" placeholder="Nhập nhận xét đánh giá đề tài, lý do yêu cầu sửa hoặc lý do từ chối..."></textarea>
                        <div class="form-text small">Bắt buộc nhập khi yêu cầu chỉnh sửa hoặc từ chối đề tài.</div>
                    </div>

                    <div class="d-grid gap-2">
                        <!-- Nút Phê duyệt -->
                        <form asp-action="Approve" asp-route-id="@topic.Id" method="post" id="approveForm" onsubmit="return handleApprove(event);">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="comments" id="approveCommentsInput" />
                            <button type="submit" class="btn btn-success w-100 py-2 fw-semibold">
                                <i class="bi bi-check-circle me-1"></i> Phê duyệt đề tài
                            </button>
                        </form>

                        <!-- Nút Yêu cầu chỉnh sửa -->
                        <form asp-action="RequestRevision" asp-route-id="@topic.Id" method="post" id="revisionForm" onsubmit="return handleRevision(event);">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="comments" id="revisionCommentsInput" />
                            <button type="submit" class="btn btn-warning w-100 py-2 fw-semibold">
                                <i class="bi bi-arrow-repeat me-1"></i> Yêu cầu chỉnh sửa
                            </button>
                        </form>

                        <!-- Nút Từ chối -->
                        <form asp-action="Reject" asp-route-id="@topic.Id" method="post" id="rejectForm" onsubmit="return handleReject(event);">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="comments" id="rejectCommentsInput" />
                            <button type="submit" class="btn btn-danger w-100 py-2 fw-semibold">
                                <i class="bi bi-x-circle me-1"></i> Từ chối đề tài
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="alert alert-secondary mb-0 small">
                        <i class="bi bi-info-circle me-1"></i>
                        Đề tài hiện đang ở trạng thái <strong>@InternshipManagement.Web.Models.TopicStatuses.GetDisplayName(topic.Status)</strong>. Chỉ có thể thực hiện xét duyệt khi đề tài ở trạng thái 'Chờ xét duyệt'.
                    </div>
                }
            </div>

            <!-- Thông tin Giảng viên đăng ký -->
            <div class="card card-custom p-4">
                <h6 class="fw-bold text-secondary border-bottom pb-2 mb-3">
                    <i class="bi bi-person-badge me-2"></i>Giảng viên đề xuất
                </h6>
                <div class="small mb-3">
                    <div class="text-muted">Họ và tên:</div>
                    <div class="fw-bold text-dark">@(topic.LecturerProfile?.User?.FullName ?? "--")</div>
                </div>
                <div class="small mb-3">
                    <div class="text-muted">Mã giảng viên:</div>
                    <div class="fw-semibold text-primary">@(topic.LecturerProfile?.LecturerCode ?? "--")</div>
                </div>
                <div class="small mb-3">
                    <div class="text-muted">Khoa / Bộ môn:</div>
                    <div class="fw-semibold text-dark">
                        @(topic.LecturerProfile?.Faculty?.Name) - @(topic.LecturerProfile?.DepartmentName ?? "Chưa cập nhật")
                    </div>
                </div>
                <div class="small mb-0">
                    <div class="text-muted">Học hàm / Học vị:</div>
                    <div class="fw-semibold text-dark">
                        @(topic.LecturerProfile?.AcademicTitle ?? "") @(topic.LecturerProfile?.AcademicDegree ?? "")
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function handleApprove(e) {
            const comments = document.getElementById('reviewComments').value.trim();
            if (!confirm('Bạn có chắc chắn muốn phê duyệt đề tài này? Sau khi duyệt, sinh viên sẽ có thể nhìn thấy đề tài.')) {
                e.preventDefault();
                return false;
            }
            document.getElementById('approveCommentsInput').value = comments || 'Đã phê duyệt đề tài';
            return true;
        }

        function handleRevision(e) {
            const comments = document.getElementById('reviewComments').value.trim();
            if (!comments) {
                alert('Vui lòng nhập ý kiến nhận xét / lý do yêu cầu chỉnh sửa vào ô bên trên.');
                document.getElementById('reviewComments').focus();
                e.preventDefault();
                return false;
            }
            if (!confirm('Gửi yêu cầu chỉnh sửa đề tài cho giảng viên?')) {
                e.preventDefault();
                return false;
            }
            document.getElementById('revisionCommentsInput').value = comments;
            return true;
        }

        function handleReject(e) {
            const comments = document.getElementById('reviewComments').value.trim();
            if (!comments) {
                alert('Vui lòng nhập lý do từ chối đề tài vào ô bên trên.');
                document.getElementById('reviewComments').focus();
                e.preventDefault();
                return false;
            }
            if (!confirm('Bạn có chắc chắn muốn từ chối đề tài này?')) {
                e.preventDefault();
                return false;
            }
            document.getElementById('rejectCommentsInput').value = comments;
            return true;
        }
    </script>
}

@using InternshipManagement.Web.Models
@model InternshipPlace
@{
    ViewData["Title"] = "Chỉnh sửa doanh nghiệp & tình trạng hợp tác";
}

<div class="page-container" style="max-width: 920px;">
    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
        <div>
            <h4 class="fw-bold text-primary mb-1">
                <i class="bi bi-building-gear me-2"></i>@ViewData["Title"]
            </h4>
            <div class="text-muted small">
                Cập nhật thông tin doanh nghiệp và trạng thái hợp tác
            </div>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Danh sách doanh nghiệp
        </a>
    </div>

    <div class="card card-custom">
        <div class="card-header-custom">
            Thông tin doanh nghiệp
        </div>

        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger py-2 small"
                     role="alert"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label small fw-semibold"></label>
                        <span class="text-danger">*</span>
                        <input asp-for="Name" class="form-control form-control-sm" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="TaxCode" class="form-label small fw-semibold"></label>
                        <input asp-for="TaxCode" class="form-control form-control-sm font-monospace" />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-8">
                        <label asp-for="Address" class="form-label small fw-semibold"></label>
                        <input asp-for="Address" class="form-control form-control-sm" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Website" class="form-label small fw-semibold"></label>
                        <input asp-for="Website" class="form-control form-control-sm" />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label asp-for="ContactPerson" class="form-label small fw-semibold"></label>
                        <input asp-for="ContactPerson" class="form-control form-control-sm" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="ContactPhone" class="form-label small fw-semibold"></label>
                        <input asp-for="ContactPhone" class="form-control form-control-sm" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="ContactEmail" class="form-label small fw-semibold"></label>
                        <input asp-for="ContactEmail" class="form-control form-control-sm" />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="DefaultPosition" class="form-label small fw-semibold"></label>
                        <input asp-for="DefaultPosition" class="form-control form-control-sm" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CooperationStatus" class="form-label small fw-semibold"></label>
                        <span class="text-danger">*</span>
                        <select asp-for="CooperationStatus" class="form-select form-select-sm">
                            @foreach (var st in BusinessCooperationStatuses.All)
                            {
                                <option value="@st">@BusinessCooperationStatuses.GetLabel(st)</option>
                            }
                        </select>
                        <span asp-validation-for="CooperationStatus" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="CooperationNote" class="form-label small fw-semibold"></label>
                    <textarea asp-for="CooperationNote" rows="3" class="form-control form-control-sm"></textarea>
                </div>

                <div class="alert alert-light border small text-muted mb-4">
                    <i class="bi bi-info-circle me-1 text-primary"></i>
                    Thay đổi thông tin doanh nghiệp và tình trạng hợp tác sẽ được áp dụng sau khi lưu.
                </div>

                <div class="d-flex justify-content-end gap-2 border-top pt-3">
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary px-3">
                        Hủy bỏ
                    </a>
                    <button type="submit" class="btn btn-sm btn-primary px-4">
                        <i class="bi bi-save me-1"></i> Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model InternshipManagement.Web.ViewModels.Terms.TermCreateEditViewModel

@{
    ViewData["Title"] = "Thêm học kỳ mới";
}

<div class="page-container">
    <div class="mb-3">
        <h4 class="fw-bold text-primary mb-1">
            <i class="bi bi-plus-circle me-2"></i>Thêm học kỳ mới
        </h4>
        <div class="text-muted small">
            Nhập thông tin học kỳ cần thêm vào hệ thống
        </div>
    </div>

    <div class="card card-custom">
        <div class="card-header-custom">
            Thông tin học kỳ
        </div>

        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="AcademicYearId" class="form-label fw-semibold"></label>
                    <select asp-for="AcademicYearId"
                            asp-items="Model.AcademicYears"
                            class="form-select">
                        <option value="">-- Chọn năm học --</option>
                    </select>
                    <span asp-validation-for="AcademicYearId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TermNo" class="form-label fw-semibold"></label>
                    <select asp-for="TermNo" class="form-select">
                        <option value="1">Học kỳ 1</option>
                        <option value="2">Học kỳ 2</option>
                    </select>
                    <span asp-validation-for="TermNo" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="StartDate" class="form-label fw-semibold"></label>
                    <input asp-for="StartDate" type="date" class="form-control">
                    <span asp-validation-for="StartDate" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EndDate" class="form-label fw-semibold"></label>
                    <input asp-for="EndDate" type="date" class="form-control">
                    <span asp-validation-for="EndDate" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary btn-sm px-3">
                        <i class="bi bi-check-circle me-1"></i> Lưu học kỳ
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

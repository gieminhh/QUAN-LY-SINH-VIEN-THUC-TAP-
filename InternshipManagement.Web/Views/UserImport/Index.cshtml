@model InternshipManagement.Web.ViewModels.UserImportViewModel
@{ ViewData["Title"] = "Nhập tài khoản từ Excel"; }
<div class="page-container backlog-page"><h4 class="fw-bold text-primary">Nhập tài khoản từ Excel</h4><a class="btn btn-outline-primary mb-3" href="/templates/users_import_template.xlsx">Tải file Excel mẫu</a><p>File .xlsx tối đa 2MB / 500 tài khoản. Cột A–E: <strong>UserName, Email, FullName, Role, InitialPassword</strong>. Vai trò: Admin, TrainingManager, FacultyManager, Lecturer, Student, Company.</p><p>Nhập dữ liệu trong sheet đầu, không dùng công thức. Tệp có lỗi cần sửa trước khi xác nhận. Mật khẩu ban đầu chỉ dùng để tạo tài khoản, không hiển thị trong kết quả.</p>
<form asp-action="Preview" method="post" enctype="multipart/form-data" class="card card-custom p-3 mb-3">@Html.AntiForgeryToken()<label for="file">File Excel</label><input id="file" name="file" type="file" accept=".xlsx" class="form-control" required/><button class="btn btn-primary mt-2">Kiểm tra dữ liệu</button></form>
@if(Model.Error!=null){<div class="alert alert-danger">@Model.Error</div>}
@if(Model.Results.Any()){<div class="card card-custom p-3 table-responsive"><h5>@(Model.Finished?"Kết quả nhập":"Kết quả kiểm tra")</h5><p>Hợp lệ / thành công: @Model.Results.Count(x=>x.Success) / @Model.Results.Count</p><table class="table"><thead><tr><th>Dòng</th><th>Tài khoản</th><th>Kết quả</th></tr></thead><tbody>@foreach(var x in Model.Results){<tr><td>@x.Row</td><td>@x.UserName</td><td class="@(x.Success?"text-success":"text-danger")">@x.Message</td></tr>}</tbody></table>
@if(Model.Ticket!=null){<form asp-action="Confirm" method="post">@Html.AntiForgeryToken()<input name="ticket" value="@Model.Ticket" type="hidden"/><button class="btn btn-success">Xác nhận tạo tài khoản</button></form>}</div>}</div>

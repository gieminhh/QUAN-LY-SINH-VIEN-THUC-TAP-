@model InternshipManagement.Web.ViewModels.Users.UserListViewModel

@{
    ViewData["Title"] = "Quản lý tài khoản người dùng";
}

<div class="page-container">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h4 class="fw-bold text-primary mb-1">
                <i class="bi bi-people-fill me-2"></i>Quản lý tài khoản người dùng
            </h4>
            <div class="text-muted small">Kiểm soát danh sách người dùng, vai trò và trạng thái truy cập hệ thống</div>
        </div>
        <div>
            <a asp-action="ImportExcel" class="btn btn-success btn-sm px-3">
        <i class="bi bi-file-earmark-excel me-1"></i> Nhập từ Excel
    </a>
            <a asp-action="Create" class="btn btn-primary btn-sm px-3">
                <i class="bi bi-person-plus-fill me-1"></i> Thêm tài khoản mới
            </a>
        </div>
    </div>

    <!-- Search & Filter Card -->
    <div class="card card-custom p-3 mb-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Tìm kiếm theo tên, username, email..." value="@Model.Search">
                </div>
            </div>
            <div class="col-md-3">
                <select name="roleFilter" class="form-select form-select-sm">
                    <option value="">-- Tất cả vai trò --</option>
                    @foreach (var role in Model.AvailableRoles)
                    {
                        <option value="@role" selected="@(Model.RoleFilter == role)">@AppRoles.GetDisplayName(role)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="statusFilter" class="form-select form-select-sm">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="active" selected="@(Model.StatusFilter == "active")">Đang hoạt động</option>
                    <option value="inactive" selected="@(Model.StatusFilter == "inactive")">Bị vô hiệu hóa</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-primary w-100">
                    <i class="bi bi-funnel"></i> Lọc
                </button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Đặt lại bộ lọc">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- User Table Card -->
    <div class="card card-custom">
        <div class="card-header-custom d-flex justify-content-between align-items-center">
            <span>Danh sách người dùng (@Model.TotalCount tài khoản)</span>
            <span class="small text-muted">Trang @Model.Page / @Math.Max(1, Model.TotalPages)</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Họ và tên</th>
                        <th>Tên đăng nhập</th>
                        <th>Email</th>
                        <th>Vai trò</th>
                        <th class="text-center">Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th class="text-end pe-3">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @if (Model.Users.Any())
                    {
                        @foreach (var u in Model.Users)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold text-dark">@u.FullName</div>
                                </td>
                                <td><code>@u.UserName</code></td>
                                <td class="text-muted">@u.Email</td>
                                <td>
                                    @foreach (var r in u.Roles)
                                    {
                                        <span class="badge bg-primary me-1">@AppRoles.GetDisplayName(r)</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (u.IsActive)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Vô hiệu</span>
                                    }
                                    @if (u.IsLockedOut)
                                    {
                                        <span class="badge bg-warning text-dark"><i class="bi bi-lock me-1"></i>Tạm khóa</span>
                                    }
                                </td>
                                <td class="text-muted">@u.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-outline-primary" title="Chỉnh sửa thông tin">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-action="ManageScopes" asp-route-id="@u.Id" class="btn btn-outline-info" title="Phân quyền phạm vi (Scope)">
                                            <i class="bi bi-shield-lock"></i>
                                        </a>
                                        @if (u.CanModify)
                                        {
                                            <form asp-action="ToggleStatus" asp-route-id="@u.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn đổi trạng thái tài khoản @u.UserName?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn @(u.IsActive ? "btn-outline-danger" : "btn-outline-success")" title="@(u.IsActive ? "Khóa tài khoản" : "Mở khóa tài khoản")">
                                                    <i class="bi @(u.IsActive ? "bi-lock-fill" : "bi-unlock-fill")"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                                Không tìm thấy tài khoản người dùng nào phù hợp.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-between align-items-center py-2">
                <span class="small text-muted">Hiển thị @Model.Users.Count trên tổng số @Model.TotalCount</span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search" asp-route-roleFilter="@Model.RoleFilter" asp-route-statusFilter="@Model.StatusFilter">Trước</a>
                        </li>
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.Page ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@Model.Search" asp-route-roleFilter="@Model.RoleFilter" asp-route-statusFilter="@Model.StatusFilter">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search" asp-route-roleFilter="@Model.RoleFilter" asp-route-statusFilter="@Model.StatusFilter">Sau</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

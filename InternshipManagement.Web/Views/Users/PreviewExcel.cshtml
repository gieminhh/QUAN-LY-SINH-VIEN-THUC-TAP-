@model InternshipManagement.Web.ViewModels.Users.ImportUsersViewModel

@{
    ViewData["Title"] = "Xem trước dữ liệu Excel";
}

<h2>Xem trước dữ liệu nhập Excel</h2>

<div class="mb-3">
    <span class="badge bg-success">
        Hợp lệ: @Model.Rows.Count(x => x.IsValid)
    </span>

    <span class="badge bg-danger">
        Không hợp lệ: @Model.Rows.Count(x => !x.IsValid)
    </span>

    <span class="badge bg-secondary">
        Tổng số dòng: @Model.Rows.Count
    </span>
</div>

<form asp-action="ConfirmImport" method="post">
    @Html.AntiForgeryToken()

    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Dòng Excel</th>
                    <th>Username</th>
                    <th>Email</th>
                    <th>Họ tên</th>
                    <th>Số điện thoại</th>
                    <th>Vai trò</th>
                    <th>Trạng thái</th>
                    <th>Lỗi</th>
                </tr>
            </thead>

            <tbody>
                @for (int i = 0; i < Model.Rows.Count; i++)
                {
                    var row = Model.Rows[i];

                    <tr>
                        <td>
                            @row.RowNumber
                            <input type="hidden" name="Rows[@i].RowNumber" value="@row.RowNumber" />
                        </td>

                        <td>
                            @row.UserName
                            <input type="hidden" name="Rows[@i].UserName" value="@row.UserName" />
                        </td>

                        <td>
                            @row.Email
                            <input type="hidden" name="Rows[@i].Email" value="@row.Email" />
                        </td>

                        <td>
                            @row.FullName
                            <input type="hidden" name="Rows[@i].FullName" value="@row.FullName" />
                        </td>

                        <td>
                            @row.PhoneNumber
                            <input type="hidden" name="Rows[@i].PhoneNumber" value="@row.PhoneNumber" />
                        </td>

                        <td>
                            @row.Role
                            <input type="hidden" name="Rows[@i].Role" value="@row.Role" />
                        </td>

                        <td>
                            @if (row.IsValid)
                            {
                                <span class="badge bg-success">Hợp lệ</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Không hợp lệ</span>
                            }

                            <input type="hidden" name="Rows[@i].IsValid" value="@row.IsValid" />
                        </td>

                        <td class="text-danger">
                            @row.ErrorMessage
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <button type="submit" class="btn btn-success">
        <i class="bi bi-check-circle"></i>
        Xác nhận nhập tài khoản
    </button>

    <a asp-action="ImportExcel" class="btn btn-secondary">
        Quay lại
    </a>
</form>

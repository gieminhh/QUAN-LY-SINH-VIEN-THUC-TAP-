@model InternshipManagement.Web.ViewModels.Faculties.FacultyCreateEditViewModel

@{
    ViewData["Title"] = "Thêm khoa mới";
}

<div class="page-container" style="max-width: 860px;">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h4 class="fw-bold text-primary mb-1">
                <i class="bi bi-plus-circle me-2"></i>Thêm khoa mới
            </h4>
            <div class="text-muted small">
                Khai báo thông tin khoa thuộc Trường Đại học Vinh
            </div>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Danh sách khoa
        </a>
    </div>

    <div class="card card-custom">
        <div class="card-header-custom">
            Thông tin khoa
        </div>

        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger py-2 small"
                     role="alert"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label asp-for="Code" class="form-label small fw-semibold"></label>
                        <span class="text-danger">*</span>

                        <input asp-for="Code"
                               class="form-control form-control-sm font-monospace"
                               placeholder="Ví dụ: CNTT">

                        <span asp-validation-for="Code" class="text-danger small"></span>
                        <small class="text-muted">Mã khoa phải là duy nhất.</small>
                    </div>

                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label small fw-semibold"></label>
                        <span class="text-danger">*</span>

                        <input asp-for="Name"
                               class="form-control form-control-sm"
                               placeholder="Ví dụ: Khoa Công nghệ Thông tin">

                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input">
                        <label asp-for="IsActive" class="form-check-label small fw-semibold"></label>
                    </div>
                    <small class="text-muted">
                        Khoa đang hoạt động có thể được sử dụng khi quản lý ngành đào tạo.
                    </small>
                </div>

                <div class="alert alert-light border small text-muted mb-4">
                    <i class="bi bi-info-circle me-1 text-primary"></i>
                    Vui lòng kiểm tra mã và tên khoa trước khi lưu.
                </div>

                <div class="d-flex justify-content-end gap-2 border-top pt-3">
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary px-3">
                        Hủy bỏ
                    </a>

                    <button type="submit" class="btn btn-sm btn-primary px-4">
                        <i class="bi bi-save me-1"></i> Lưu khoa
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
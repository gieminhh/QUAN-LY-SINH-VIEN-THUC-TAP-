@model InternshipManagement.Web.ViewModels.Faculties.FacultyListViewModel

@{
    ViewData["Title"] = "Quản lý khoa";
}

<div class="page-container">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h4 class="fw-bold text-primary mb-1">
                <i class="bi bi-building me-2"></i>Quản lý khoa
            </h4>
            <div class="text-muted small">
                Quản lý danh sách khoa và các ngành đào tạo trực thuộc
            </div>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-sm px-3">
            <i class="bi bi-plus-circle me-1"></i> Thêm khoa mới
        </a>
    </div>

    <!-- Search & Filter -->
    <div class="card card-custom p-3 mb-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="search" class="form-control"
                           placeholder="Mã hoặc tên khoa..." value="@Model.Search">
                </div>
            </div>

            <div class="col-md-3">
                <select name="statusFilter" class="form-select form-select-sm">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="active" selected="@(Model.StatusFilter == "active")">Đang hoạt động</option>
                    <option value="inactive" selected="@(Model.StatusFilter == "inactive")">Ngừng hoạt động</option>
                </select>
            </div>

            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-primary w-100" title="Áp dụng bộ lọc">
                    <i class="bi bi-funnel"></i>
                </button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Xóa bộ lọc">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Faculty Table -->
    <div class="card card-custom">
        <div class="card-header-custom d-flex justify-content-between align-items-center">
            <span>Danh sách khoa (@Model.TotalCount khoa)</span>
            <span class="small text-muted">
                Trang @Model.Page / @Math.Max(1, Model.TotalPages)
            </span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Mã khoa</th>
                        <th>Tên khoa</th>
                        <th class="text-center">Số ngành</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-end pe-3">Thao tác</th>
                    </tr>
                </thead>

                <tbody class="small">
                    @if (Model.Faculties.Any())
                    {
                        @foreach (var f in Model.Faculties)
                        {
                            <tr>
                                <td>
                                    <span class="fw-bold font-monospace text-primary">@f.Code</span>
                                </td>
                                <td class="fw-semibold">@f.Name</td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">
                                        @f.MajorCount ngành
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (f.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle me-1"></i>Đang hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="bi bi-pause-circle me-1"></i>Ngừng hoạt động
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@f.Id"
                                           class="btn btn-outline-primary" title="Chỉnh sửa">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <form asp-action="ToggleStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="search" value="@Model.Search">
                                            <input type="hidden" name="statusFilter" value="@Model.StatusFilter">
                                            <input type="hidden" name="id" value="@f.Id">
                                            <button type="submit"
                                                    onclick="return confirm('Bạn có chắc chắn muốn thay đổi trạng thái khoa này không?');"
                                                    class="btn @(f.IsActive ? "btn-outline-warning" : "btn-outline-success")"
                                                    title="@(f.IsActive ? "Ngừng hoạt động" : "Kích hoạt")">
                                                <i class="bi @(f.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                <i class="bi bi-building-x fs-3 d-block mb-1"></i>
                                Không tìm thấy khoa nào phù hợp.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-between align-items-center py-2">
                <span class="small text-muted">
                    Hiển thị @Model.Faculties.Count / tổng số @Model.TotalCount khoa
                </span>

                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@(Model.Page - 1)"
                               asp-route-search="@Model.Search"
                               asp-route-statusFilter="@Model.StatusFilter">Trước</a>
                        </li>

                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.Page ? "active" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-page="@p"
                                   asp-route-search="@Model.Search"
                                   asp-route-statusFilter="@Model.StatusFilter">@p</a>
                            </li>
                        }

                        <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@(Model.Page + 1)"
                               asp-route-search="@Model.Search"
                               asp-route-statusFilter="@Model.StatusFilter">Sau</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
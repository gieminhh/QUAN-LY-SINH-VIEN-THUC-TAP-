@model InternshipManagement.Web.ViewModels.Faculties.FacultyCreateEditViewModel

@{
    ViewData["Title"] = "Chỉnh sửa khoa";
}

<div class="page-container" style="max-width: 860px;">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h4 class="fw-bold text-primary mb-1">
                <i class="bi bi-pencil-square me-2"></i>Chỉnh sửa thông tin khoa
            </h4>
            <div class="text-muted small">
                Cập nhật thông tin và trạng thái hoạt động của khoa
            </div>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Danh sách khoa
        </a>
    </div>

    <div class="card card-custom">
        <div class="card-header-custom">
            Thông tin khoa
        </div>

        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger py-2 small"
                     role="alert"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label asp-for="Code" class="form-label small fw-semibold"></label>
                        <span class="text-danger">*</span>

                        <input asp-for="Code"
                               class="form-control form-control-sm font-monospace" />

                        <span asp-validation-for="Code" class="text-danger small"></span>
                    </div>

                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label small fw-semibold"></label>
                        <span class="text-danger">*</span>

                        <input asp-for="Name"
                               class="form-control form-control-sm" />

                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label small fw-semibold"></label>
                    </div>

                    <small class="text-muted">
                        Khi ngừng hoạt động, khoa sẽ không được chọn trong các nghiệp vụ tạo ngành mới.
                    </small>
                </div>

                <div class="alert alert-light border small text-muted mb-4">
                    <i class="bi bi-info-circle me-1 text-primary"></i>
                    Thay đổi thông tin khoa sẽ được áp dụng sau khi lưu.
                </div>

                <div class="d-flex justify-content-end gap-2 border-top pt-3">
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary px-3">
                        Hủy bỏ
                    </a>

                    <button type="submit" class="btn btn-sm btn-primary px-4">
                        <i class="bi bi-save me-1"></i> Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
@model InternshipManagement.Web.Models.DoanhNghiep
@using InternshipManagement.Web.Models

@{
    ViewData["Title"] = "Sửa doanh nghiệp";
}

<h1>Sửa doanh nghiệp</h1>
<form asp-action="Edit" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div>
        <label asp-for="Ten"></label>
        <input asp-for="Ten" />
        <span asp-validation-for="Ten" class="text-danger"></span>
    </div>
    <div>
        <label asp-for="MaSoThue"></label>
        <input asp-for="MaSoThue" />
        <span asp-validation-for="MaSoThue" class="text-danger"></span>
    </div>
    <div>
        <label asp-for="LinhVuc"></label>
        <input asp-for="LinhVuc" />
    </div>
    <div>
        <label asp-for="DiaChi"></label>
        <input asp-for="DiaChi" />
    </div>
    <div>
        <label asp-for="NguoiLienHe"></label>
        <input asp-for="NguoiLienHe" />
    </div>
    <div>
        <label asp-for="SoDienThoai"></label>
        <input asp-for="SoDienThoai" />
    </div>
    <div>
        <label asp-for="Email"></label>
        <input asp-for="Email" />
    </div>
    <div>
        <label asp-for="TrangThai"></label>
        <select asp-for="TrangThai" asp-items="Html.GetEnumSelectList<TrangThaiHopTac>()"></select>
    </div>
    <div>
        <label for="fileHopTac">File hợp tác</label>
        <input type="file" id="fileHopTac" name="fileHopTac" accept=".pdf,.doc,.docx" />
        @if (!string.IsNullOrEmpty(Model.FileHopTac))
        {
            <a href="@Model.FileHopTac">File hiện tại</a>
        }
        @foreach (var error in ViewData.ModelState["fileHopTac"]?.Errors ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.ModelBinding.ModelError>())
        {
            <span class="text-danger">@error.ErrorMessage</span>
        }
    </div>
    <button type="submit">Lưu thay đổi</button>
    <a asp-action="Index">Quay lại</a>
</form>

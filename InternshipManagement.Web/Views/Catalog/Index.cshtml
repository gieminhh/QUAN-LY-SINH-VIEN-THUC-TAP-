@model InternshipManagement.Web.ViewModels.CatalogViewModel
@{ ViewData["Title"] = "Danh mục học vụ"; }
<div class="page-container backlog-page"><h4 class="fw-bold text-primary">Danh mục học vụ</h4><nav class="d-flex gap-2 mb-3"><a href="?kind=faculty">Khoa</a><a href="?kind=major">Ngành</a><a href="?kind=year">Năm học</a><a href="?kind=term">Học kỳ</a></nav>
<div class="row g-3"><div class="col-lg-5"><form asp-action="Save" method="post" class="card card-custom p-3">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger"></div><input asp-for="Kind" type="hidden"/><input asp-for="Id" type="hidden"/><h5>@(Model.Id==0?"Thêm mới":"Chỉnh sửa")</h5>
@if(Model.Kind!="term"){<label>Mã</label><input asp-for="Code" class="form-control mb-3"/>}
@if(Model.Kind is "faculty" or "major"){<label>Tên</label><input asp-for="Name" class="form-control mb-3"/><label><input asp-for="IsActive"/> Đang sử dụng</label>}
@if(Model.Kind is "major" or "term"){<label>@(Model.Kind=="major"?"Khoa":"Năm học")</label><select asp-for="ParentId" asp-items="Model.Parents" class="form-select mb-3"></select>}
@if(Model.Kind=="term"){<label>Số học kỳ (1–3)</label><input asp-for="TermNo" type="number" min="1" max="3" class="form-control"/>}
@if(Model.Kind is "year" or "term"){<label>Ngày bắt đầu</label><input asp-for="StartDate" type="date" class="form-control"/><label>Ngày kết thúc</label><input asp-for="EndDate" type="date" class="form-control"/>}
<button class="btn btn-primary mt-3">Lưu danh mục</button></form></div><div class="col-lg-7"><div class="card card-custom p-3 table-responsive"><table class="table"><thead><tr><th>Mã</th><th>Tên / thời gian</th><th>Thao tác</th></tr></thead><tbody>@foreach(var row in Model.Rows){<tr><td>@row.Code</td><td>@row.Name</td><td><a asp-action="Index" asp-route-kind="@Model.Kind" asp-route-id="@row.Id">Sửa</a><form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Xóa danh mục chưa được sử dụng?')">@Html.AntiForgeryToken()<input name="kind" value="@Model.Kind" type="hidden"/><input name="id" value="@row.Id" type="hidden"/><button class="btn btn-sm btn-outline-danger">Xóa</button></form></td></tr>}</tbody></table></div></div></div></div>

@model InternshipManagement.Web.ViewModels.TopicApprovals.TopicApprovalListViewModel
@using InternshipManagement.Web.Models

@{
    ViewData["Title"] = "Duyệt đề tài";
}

<div class="page-container">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h4 class="fw-bold text-primary mb-1">
                <i class="bi bi-clipboard-check-fill me-2"></i>Duyệt đề tài
            </h4>
            <div class="text-muted small">
                Xem xét, phê duyệt hoặc từ chối các đề tài do giảng viên đăng ký.
            </div>
        </div>
    </div>

    <!-- Search & Filter Card -->
    <div class="card card-custom p-3 mb-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text"
                           name="Search"
                           class="form-control"
                           placeholder="Tìm tên đề tài..."
                           value="@Model.Search">
                </div>
            </div>

            <div class="col-md-4">
                <select name="CampaignFilter" class="form-select form-select-sm">
                    <option value="">-- Tất cả đợt --</option>
                    @foreach (var campaign in Model.CampaignOptions)
                    {
                        <option value="@campaign.Value"
                                selected="@(Model.CampaignFilter?.ToString() == campaign.Value)">
                            @campaign.Text
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <select name="ApprovalFilter" class="form-select form-select-sm">
                    <option value="ALL" selected="@(Model.ApprovalFilter == "ALL")">Tất cả trạng thái</option>
                    <option value="PENDING" selected="@(Model.ApprovalFilter == "PENDING")">Chờ duyệt</option>
                    <option value="APPROVED" selected="@(Model.ApprovalFilter == "APPROVED")">Đã duyệt</option>
                    <option value="REJECTED" selected="@(Model.ApprovalFilter == "REJECTED")">Đã từ chối</option>
                </select>
            </div>

            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-primary w-100" title="Áp dụng bộ lọc">
                    <i class="bi bi-funnel"></i>
                </button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Xóa bộ lọc">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Topics Table Card -->
    <div class="card card-custom">
        <div class="card-header-custom d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span>Danh sách đề tài (@Model.TotalCount đề tài)</span>
            <span class="small text-muted">
                Trang @Model.Page / @Math.Max(1, Model.TotalPages)
            </span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Đề tài</th>
                        <th>Đợt đăng ký</th>
                        <th>Hình thức</th>
                        <th>Người tạo</th>
                        <th>Ngày đăng ký</th>
                        <th class="text-center">Trạng thái duyệt</th>
                        <th>Người xử lý</th>
                        <th class="text-end pe-3">Thao tác</th>
                    </tr>
                </thead>

                <tbody class="small">
                    @if (Model.Topics.Any())
                    {
                        @foreach (var topic in Model.Topics)
                        {
                            <tr>
                                <td>
                                    <a asp-action="Details"
                                       asp-route-id="@topic.Id"
                                       class="text-decoration-none fw-semibold text-dark">
                                        @topic.Title
                                    </a>

                                    @if (topic.ApprovalStatus == TopicApprovalStatuses.Rejected
                                         && !string.IsNullOrWhiteSpace(topic.RejectionReason))
                                    {
                                        <div class="text-danger small mt-1">
                                            <i class="bi bi-info-circle me-1"></i>
                                            Có lý do từ chối
                                        </div>
                                    }
                                </td>

                                <td>
                                    <span class="fw-semibold">@topic.CampaignName</span>
                                </td>

                                <td>
                                    @if (topic.TopicType == TopicTypes.Individual)
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary">
                                            <i class="bi bi-person me-1"></i>Cá nhân
                                        </span>
                                    }
                                    else if (topic.TopicType == TopicTypes.Group)
                                    {
                                        <span class="badge bg-info bg-opacity-10 text-info border border-info">
                                            <i class="bi bi-people me-1"></i>Nhóm
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border">@topic.TopicType</span>
                                    }
                                </td>

                                <td>@topic.CreatedByName</td>

                                <td class="text-muted">
                                    @topic.CreatedAt.ToString("dd/MM/yyyy")
                                </td>

                                <td class="text-center">
                                    @switch (topic.ApprovalStatus)
                                    {
                                        case TopicApprovalStatuses.Pending:
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-hourglass-split me-1"></i>Chờ duyệt
                                            </span>
                                            break;

                                        case TopicApprovalStatuses.Approved:
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle-fill me-1"></i>Đã duyệt
                                            </span>
                                            break;

                                        case TopicApprovalStatuses.Rejected:
                                            <span class="badge bg-danger">
                                                <i class="bi bi-x-circle-fill me-1"></i>Đã từ chối
                                            </span>
                                            break;

                                        default:
                                            <span class="badge bg-secondary">Không xác định</span>
                                            break;
                                    }
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(topic.ReviewerName))
                                    {
                                        <span>@topic.ReviewerName</span>
                                        @if (topic.ReviewedAt.HasValue)
                                        {
                                            <div class="text-muted small">
                                                @topic.ReviewedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">Chưa xử lý</span>
                                    }
                                </td>

                                <td class="text-end pe-3">
                                    <a asp-action="Details"
                                       asp-route-id="@topic.Id"
                                       class="btn btn-outline-info btn-sm"
                                       title="Xem chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                <i class="bi bi-clipboard-x fs-3 d-block mb-1"></i>
                                Không tìm thấy đề tài nào trong phạm vi quản lý của bạn.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-between align-items-center flex-wrap gap-2 py-2">
                <span class="small text-muted">
                    Hiển thị @Model.Topics.Count / tổng số @Model.TotalCount đề tài
                </span>

                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.Page - 1)"
                               asp-route-search="@Model.Search"
                               asp-route-campaignFilter="@Model.CampaignFilter"
                               asp-route-approvalFilter="@Model.ApprovalFilter">
                                Trước
                            </a>
                        </li>

                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.Page ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@p"
                                   asp-route-search="@Model.Search"
                                   asp-route-campaignFilter="@Model.CampaignFilter"
                                   asp-route-approvalFilter="@Model.ApprovalFilter">
                                    @p
                                </a>
                            </li>
                        }

                        <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.Page + 1)"
                               asp-route-search="@Model.Search"
                               asp-route-campaignFilter="@Model.CampaignFilter"
                               asp-route-approvalFilter="@Model.ApprovalFilter">
                                Sau
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
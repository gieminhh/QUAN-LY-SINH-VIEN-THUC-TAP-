@model InternshipManagement.Web.ViewModels.AssignmentViewModel
@{ ViewData["Title"] = "Phân công sinh viên"; }
<div class="page-container backlog-page"><h4 class="fw-bold text-primary">Phân công sinh viên và kiểm soát hạn mức</h4><form method="get"><label>Đợt</label><select name="campaignId" class="form-select">@foreach(var c in Model.Campaigns){<option value="@c.Id" selected="@(c.Id==Model.Campaign.Id)">@c.Name</option>}</select><button class="btn btn-primary mt-2">Chọn đợt</button></form><form asp-action="Assign" method="post" class="card card-custom p-3 my-3">@Html.AntiForgeryToken()<input name="campaignId" value="@Model.Campaign.Id" type="hidden"/><label>Sinh viên</label><select name="studentId" class="form-select">@foreach(var s in Model.Students){<option value="@s.Id">@s.StudentCode — @s.User?.FullName</option>}</select><label>Giảng viên hướng dẫn</label><select name="lecturerId" class="form-select">@foreach(var l in Model.Lecturers){<option value="@l.Id">@l.User?.FullName</option>}</select><label>Người hướng dẫn doanh nghiệp (bắt buộc với thực tập)</label><select name="mentorId" class="form-select"><option value="">Không áp dụng</option>@foreach(var m in Model.Mentors){<option value="@m.Id">@m.Name</option>}</select><label>Phê duyệt vượt hạn mức — lý do (để trống nếu không xin ngoại lệ)</label><textarea name="quotaOverrideReason" maxlength="1000" class="form-control"></textarea><p class="text-muted small">Cán bộ xác nhận thao tác này đồng thời phê duyệt ngoại lệ nếu có lý do. Hệ thống lưu người thực hiện và thời điểm.</p><button class="btn btn-primary mt-2">Xác nhận phân công</button></form><div class="card card-custom p-3"><h5>Phân công hiện tại</h5>@foreach(var a in Model.Assignments){<p>@(Model.Students.FirstOrDefault(s=>s.Id==a.StudentProfileId)?.User?.FullName) → @(Model.Lecturers.FirstOrDefault(l=>l.Id==a.LecturerProfileId)?.User?.FullName) · @a.AssignedAt.ToString("dd/MM/yyyy HH:mm")</p>@if(!string.IsNullOrWhiteSpace(a.QuotaOverrideReason)){<p class="text-warning">Ngoại lệ: @a.QuotaOverrideReason · Người duyệt: @a.AssignedBy</p>}}</div></div>

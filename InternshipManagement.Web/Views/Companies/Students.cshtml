@model List<InternshipManagement.Web.ViewModels.AssignedStudentRow>
@{ ViewData["Title"] = "Sinh viên được phân công"; }
<div class="page-container backlog-page"><h4 class="fw-bold text-primary">Sinh viên được phân công hướng dẫn</h4>@if(!Model.Any()){<p>Bạn chưa được phân công sinh viên.</p>}@foreach(var s in Model){<div class="card card-custom p-3 mb-2"><h5>@s.Code — @s.Name</h5><p>@s.Campaign</p><a href="/StudentProfile?id=@s.Id">Xem hồ sơ</a></div>}</div>

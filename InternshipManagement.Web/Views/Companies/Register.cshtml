@model InternshipManagement.Web.ViewModels.CompaniesViewModel
@{ ViewData["Title"] = "Hồ sơ doanh nghiệp"; }
<div class="page-container backlog-page"><h4 class="fw-bold text-primary">Hồ sơ doanh nghiệp</h4><form method="post" class="card card-custom p-3 mb-3">@Html.AntiForgeryToken()<h5>Gửi yêu cầu đăng ký</h5><label>Tên doanh nghiệp *</label><input name="Name" required maxlength="200" class="form-control"/><label>Mã đăng ký / mã số thuế *</label><input name="RegistrationCode" required maxlength="60" class="form-control"/><label>Ngành đề nghị hợp tác *</label><select name="MajorId" class="form-select">@foreach(var m in Model.Majors){<option value="@m.Id">@m.Name</option>}</select><label>Email liên hệ *</label><input name="Email" type="email" required class="form-control"/><label>Người đại diện / hướng dẫn *</label><input name="ContactName" required maxlength="180" class="form-control"/><label>Địa chỉ *</label><input name="Address" required maxlength="255" class="form-control"/><button class="btn btn-primary mt-3">Gửi yêu cầu đăng ký</button></form>
@foreach(var c in Model.Companies){<div class="card card-custom p-3 mb-3"><h5>@c.Name</h5><p>Mã: @c.RegistrationCode — @(c.Status=="APPROVED"?"Đã xác minh":c.Status=="REJECTED"?"Từ chối":"Chờ xét duyệt")</p><p>@c.ReviewReason</p>@if(c.Status=="APPROVED"){<h6>Người hướng dẫn</h6>@foreach(var m in Model.Mentors.Where(m=>m.CompanyId==c.Id)){<p>@m.Name</p>}<form asp-action="AddMentor" method="post">@Html.AntiForgeryToken()<input name="companyId" value="@c.Id" type="hidden"/><label>Email tài khoản người hướng dẫn</label><input name="email" type="email" required class="form-control"/><label>Họ tên</label><input name="name" required maxlength="180" class="form-control"/><button class="btn btn-outline-primary mt-2">Thêm người hướng dẫn</button></form>}</div>}</div>

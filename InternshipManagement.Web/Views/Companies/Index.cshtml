@model InternshipManagement.Web.ViewModels.CompaniesViewModel
@{ ViewData["Title"] = "Xét duyệt doanh nghiệp"; }
<div class="page-container backlog-page"><h4 class="fw-bold text-primary">Xác minh doanh nghiệp trong phạm vi</h4>@if(!Model.Companies.Any()){<p>Chưa có yêu cầu đăng ký.</p>}@foreach(var c in Model.Companies){<div class="card card-custom p-3 mb-3"><h5>@c.Name — @c.RegistrationCode</h5><p>@c.Email · @c.ContactName · @c.Address</p><p>Trạng thái: @(c.Status=="APPROVED"?"Đã xác minh":c.Status=="REJECTED"?"Từ chối":"Chờ xét duyệt")</p>@if(c.Status=="PENDING"){<form asp-action="Review" method="post">@Html.AntiForgeryToken()<input name="id" value="@c.Id" type="hidden"/><label>Lý do xét duyệt *</label><textarea name="reason" maxlength="1000" required class="form-control"></textarea><button name="decision" value="APPROVED" class="btn btn-success mt-2">Phê duyệt</button><button name="decision" value="REJECTED" class="btn btn-outline-danger mt-2">Từ chối</button></form>}else{<p>@c.ReviewReason — @c.ReviewedAt</p>}</div>}</div>

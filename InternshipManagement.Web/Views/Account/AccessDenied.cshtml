@{
    ViewData["Title"] = "Từ chối truy cập (403)";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 text-center">
            <div class="card card-custom p-5">
                <div class="mb-4">
                    <i class="bi bi-shield-lock-fill text-danger" style="font-size: 72px;"></i>
                </div>
                <h2 class="fw-bold text-danger mb-3">403 — TỪ CHỐI TRUY CẬP</h2>
                <h5 class="fw-semibold text-secondary mb-3">Bạn không có quyền thực hiện thao tác hoặc truy cập tài nguyên này</h5>
                <p class="text-muted small mb-4">
                    Hệ thống đã xác thực danh tính của bạn, tuy nhiên vai trò hoặc phạm vi quản lý được cấp (Scope) của bạn không đủ điều kiện để truy cập dữ liệu này theo chính sách bảo mật của Trường Đại học Vinh.
                </p>
                <div class="d-flex justify-content-center gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">
                        <i class="bi bi-house-door me-1"></i> Quay về Trang chủ
                    </a>
                    <a href="javascript:history.back()" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại trang trước
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

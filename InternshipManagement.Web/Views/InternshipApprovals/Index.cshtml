@model InternshipManagement.Web.ViewModels.InternshipRegistrations.InternshipApprovalListViewModel
@using InternshipManagement.Web.Models

@{
    ViewData["Title"] = "Xét duyệt nơi thực tập";
}

<div class="page-container">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h4 class="fw-bold text-primary mb-1">
                <i class="bi bi-building-check me-2"></i>Xét duyệt nơi thực tập
            </h4>
            <div class="text-muted small">Phê duyệt hoặc từ chối hồ sơ đăng ký nơi thực tập trong phạm vi quản lý.</div>
        </div>
    </div>

    <div class="card card-custom p-3 mb-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-4">
                <input type="text" name="Search" value="@Model.Search" class="form-control form-control-sm"
                       placeholder="Tìm sinh viên hoặc tên nơi thực tập..." />
            </div>
            <div class="col-md-4">
                <select name="CampaignFilter" class="form-select form-select-sm">
                    <option value="">-- Tất cả đợt thực tập --</option>
                    @foreach (var camp in Model.CampaignOptions)
                    {
                        <option value="@camp.Value" selected="@(Model.CampaignFilter?.ToString() == camp.Value)">@camp.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="ApprovalFilter" class="form-select form-select-sm">
                    <option value="ALL" selected="@(Model.ApprovalFilter == "ALL")">Tất cả trạng thái</option>
                    <option value="PENDING" selected="@(Model.ApprovalFilter == "PENDING")">Chờ duyệt</option>
                    <option value="APPROVED" selected="@(Model.ApprovalFilter == "APPROVED")">Đã duyệt</option>
                    <option value="REJECTED" selected="@(Model.ApprovalFilter == "REJECTED")">Bị từ chối</option>
                </select>
            </div>
            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-primary w-100"><i class="bi bi-funnel"></i></button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>

    <div class="card card-custom">
        <div class="card-header-custom">Danh sách đăng ký nơi thực tập (@Model.TotalCount)</div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th>Sinh viên</th>
                        <th>Đợt thực tập</th>
                        <th>Nơi thực tập</th>
                        <th>Ngày gửi</th>
                        <th class="text-center">Trạng thái</th>
                        <th>Người xử lý</th>
                        <th class="text-end pe-3">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Registrations.Any())
                    {
                        foreach (var item in Model.Registrations)
                        {
                            <tr>
                                <td class="fw-semibold">@item.StudentName</td>
                                <td>@item.CampaignName</td>
                                <td>
                                    <div class="fw-semibold">@item.PlaceName</div>
                                    @if (!string.IsNullOrWhiteSpace(item.PositionTitle))
                                    {
                                        <div class="text-muted">@item.PositionTitle</div>
                                    }
                                </td>
                                <td class="text-muted">@item.SubmittedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-center">
                                    @switch (item.ApprovalStatus)
                                    {
                                        case InternshipRegistrationStatuses.Pending:
                                            <span class="badge bg-warning text-dark">Chờ duyệt</span>
                                            break;
                                        case InternshipRegistrationStatuses.Approved:
                                            <span class="badge bg-success">Đã duyệt</span>
                                            break;
                                        case InternshipRegistrationStatuses.Rejected:
                                            <span class="badge bg-danger">Bị từ chối</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">@item.ApprovalStatus</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.ReviewerName))
                                    {
                                        <div>@item.ReviewerName</div>
                                        @if (item.ReviewedAt.HasValue)
                                        {
                                            <div class="text-muted">@item.ReviewedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">Chưa xử lý</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm">
                                        Xem & xử lý
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">Không có hồ sơ đăng ký nơi thực tập phù hợp.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
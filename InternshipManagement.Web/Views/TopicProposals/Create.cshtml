@model InternshipManagement.Web.ViewModels.TopicProposals.TopicProposalCreateViewModel

@{
    ViewData["Title"] = "Gửi đề xuất đề tài";
}

<div class="page-container">
    <div class="mb-3">
        <h4 class="fw-bold text-primary mb-1">
            <i class="bi bi-lightbulb me-2"></i>Gửi đề xuất đề tài
        </h4>
        <div class="text-muted small">Chọn đợt đào tạo và giảng viên đã được phân công cho bạn.</div>
    </div>

    <div class="card card-custom p-3 p-md-4">
        @if (Model.AssignmentOptions.Count == 0)
        {
            <div class="alert alert-info mb-0">
                Hiện bạn chưa có đợt đào tạo đang mở và giảng viên được phân công để gửi đề xuất.
            </div>
        }
        else
        {
            <form action="@Url.Action("Create", "TopicProposals")" method="post">
                @Html.AntiForgeryToken()
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="text-danger mb-3">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(value => value.Errors))
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    </div>
                }
                <div class="mb-3">
                    <label for="AssignmentId" class="form-label">Đợt đào tạo / giảng viên</label>
                    <select id="AssignmentId" name="AssignmentId" class="form-select">
                        <option value="">-- Chọn đợt đào tạo và giảng viên --</option>
                        @foreach (var option in Model.AssignmentOptions)
                        {
                            <option value="@option.Value" selected="@(option.Value == Model.AssignmentId.ToString())">
                                @option.Text
                            </option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label for="Title" class="form-label">Tên đề tài</label>
                    <input id="Title" name="Title" value="@Model.Title" class="form-control" maxlength="250" />
                </div>
                <div class="mb-3">
                    <label for="Description" class="form-label">Mô tả</label>
                    <textarea id="Description" name="Description" class="form-control" rows="5">@Model.Description</textarea>
                </div>
                <div class="mb-3">
                    <label for="Objectives" class="form-label">Mục tiêu</label>
                    <textarea id="Objectives" name="Objectives" class="form-control" rows="3" maxlength="1000">@Model.Objectives</textarea>
                </div>
                <div class="mb-3">
                    <label for="StudentNote" class="form-label">Ghi chú gửi giảng viên</label>
                    <textarea id="StudentNote" name="StudentNote" class="form-control" rows="2" maxlength="1000">@Model.StudentNote</textarea>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-send me-1"></i>Gửi đề xuất
                    </button>
                    <a href="@Url.Action("Index", "TopicProposals")" class="btn btn-outline-secondary">Quay lại</a>
                </div>
            </form>
        }
    </div>
</div>

@model InternshipManagement.Web.ViewModels.TopicListViewModel
@{
    ViewData["Title"] = "Đề tài đồ án & thực tập đã phê duyệt";
}

<div class="page-container sprint2-page">
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <div>
            <h4 class="fw-bold text-primary mb-1">
                <i class="bi bi-journal-check me-2"></i>DANH MỤC ĐỀ TÀI ĐÃ ĐƯỢC PHÊ DUYỆT
            </h4>
            <div class="text-muted small">Tra cứu danh sách các đề tài đồ án và thực tập chính thức do hội đồng khoa phê duyệt</div>
        </div>
        <span class="badge bg-success fs-6 px-3 py-2">
            <i class="bi bi-check-circle me-1"></i> @Model.TotalItems đề tài công bố
        </span>
    </div>

    <!-- Thanh tìm kiếm & lọc theo đợt -->
    <div class="card card-custom mb-4 p-3 bg-light">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-6">
                <input type="text" name="search" class="form-control" placeholder="Tìm theo tên đề tài, mã đề tài, công nghệ, giảng viên..." value="@Model.SearchQuery" />
            </div>
            <div class="col-md-4">
                <select name="campaignId" class="form-select" asp-items="Model.CampaignOptions">
                    <option value="">-- Tất cả các đợt đang mở --</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search"></i> Tìm kiếm
                </button>
                <a asp-action="Approved" class="btn btn-outline-secondary" title="Xóa bộ lọc" aria-label="Xóa bộ lọc">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>

    @if (Model.Topics.Any())
    {
        <div class="row g-3">
            @foreach (var topic in Model.Topics)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card card-custom h-100 d-flex flex-column shadow-sm border-0" style="border-top: 3px solid #16a34a !important;">
                        <div class="card-body flex-grow-1 p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-primary text-uppercase" style="font-size: 12px;">@topic.Code</span>
                                <span class="badge bg-success" style="font-size: 12px;">
                                    <i class="bi bi-check-circle"></i> Đã duyệt
                                </span>
                            </div>

                            <h6 class="card-title fw-bold text-dark mb-2" style="min-height: 40px;">
                                <a asp-action="Details" asp-route-id="@topic.Id" class="text-decoration-none text-dark hover-primary">
                                    @topic.Title
                                </a>
                            </h6>

                            <div class="small text-muted mb-2">
                                <i class="bi bi-person-badge text-primary me-1"></i>
                                GVHD: <strong>@(topic.LecturerProfile?.User?.FullName ?? "Giảng viên")</strong>
                            </div>

                            @if (!string.IsNullOrEmpty(topic.ResearchField))
                            {
                                <div class="small text-muted mb-2">
                                    <i class="bi bi-tag text-secondary me-1"></i>Lĩnh vực: <strong>@topic.ResearchField</strong>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(topic.Technologies))
                            {
                                <div class="small text-muted mb-2 text-truncate" title="@topic.Technologies" aria-label="@topic.Technologies">
                                    <i class="bi bi-cpu text-info me-1"></i>Công nghệ: @topic.Technologies
                                </div>
                            }

                            <div class="small text-muted mb-0">
                                <i class="bi bi-people text-success me-1"></i>Chỉ tiêu: <strong>@topic.MaxStudents</strong> sinh viên
                            </div>
                        </div>

                        <div class="card-footer bg-light p-2 border-top d-flex justify-content-between align-items-center">
                            <small class="text-muted" style="font-size: 12px;">
                                <i class="bi bi-calendar3 me-1"></i>@topic.Campaign?.Code
                            </small>
                            <a asp-action="Details" asp-route-id="@topic.Id" class="btn btn-sm btn-outline-primary py-0 px-2" style="font-size: 12px;">
                                Chi tiết <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="p-4 d-flex justify-content-center">
                <ul class="pagination pagination-sm mb-0">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(Model.Page == i ? "active" : "")">
                            <a class="page-link" asp-action="Approved" asp-route-page="@i" asp-route-campaignId="@Model.CampaignId" asp-route-search="@Model.SearchQuery">@i</a>
                        </li>
                    }
                </ul>
            </div>
        }
    }
    else
    {
        <div class="card card-custom p-5 text-center text-muted">
            <i class="bi bi-journal-x fs-1 d-block mb-2 text-secondary"></i>
            Chưa có đề tài nào được phê duyệt hoặc phù hợp với điều kiện tìm kiếm.
        </div>
    }
</div>

@model InternshipManagement.Web.ViewModels.TopicListViewModel
@{
    ViewData["Title"] = "Quản lý đề tài của tôi";
}

<div class="page-container sprint2-page">
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <div>
            <h4 class="fw-bold text-primary mb-1">
                <i class="bi bi-journal-text me-2"></i>QUẢN LÝ ĐỀ TÀI CỦA TÔI
            </h4>
            <div class="text-muted small">Danh sách các đề tài đồ án & thực tập do bạn đăng ký và quản lý</div>
        </div>
        <a asp-action="Create" class="btn btn-usmart">
            <i class="bi bi-plus-circle me-1"></i> Đăng ký đề tài mới
        </a>
    </div>

    <!-- Thanh tìm kiếm & bộ lọc -->
    <div class="card card-custom mb-4 p-3 bg-light">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <input type="text" name="search" class="form-control" placeholder="Tìm kiếm theo mã, tên đề tài, công nghệ..." value="@Model.SearchQuery" />
            </div>
            <div class="col-md-3">
                <select name="campaignId" class="form-select" asp-items="Model.CampaignOptions">
                    <option value="">-- Tất cả các đợt --</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select" asp-items="Model.StatusOptions"></select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel"></i> Lọc
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Xóa bộ lọc" aria-label="Xóa bộ lọc">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Bảng danh sách đề tài -->
    <div class="card card-custom">
        <div class="card-header-custom d-flex justify-content-between align-items-center">
            <span><i class="bi bi-list-task me-2"></i>Danh sách đề tài (@Model.TotalItems)</span>
        </div>
        <div class="card-body p-0">
            @if (Model.Topics.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 120px;">Mã đề tài</th>
                                <th>Tên đề tài</th>
                                <th>Đợt thực tập / Đồ án</th>
                                <th class="text-center" style="width: 90px;">Số SV</th>
                                <th class="text-center" style="width: 140px;">Trạng thái</th>
                                <th style="width: 110px;">Ngày tạo</th>
                                <th class="text-end" style="width: 160px;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var topic in Model.Topics)
                            {
                                <tr>
                                    <td class="fw-bold text-primary">@topic.Code</td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@topic.Id" class="text-decoration-none fw-semibold text-dark">
                                            @topic.Title
                                        </a>
                                        @if (!string.IsNullOrEmpty(topic.ResearchField))
                                        {
                                            <div class="text-muted" style="font-size: 12px;">
                                                <i class="bi bi-tag me-1"></i>@topic.ResearchField
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@topic.Campaign?.Code</div>
                                        <div class="text-muted" style="font-size: 12px;">@topic.Campaign?.Name</div>
                                    </td>
                                    <td class="text-center fw-bold">@topic.MaxStudents</td>
                                    <td class="text-center">
                                        <span class="@InternshipManagement.Web.Models.TopicStatuses.GetBadgeClass(topic.Status)">
                                            @InternshipManagement.Web.Models.TopicStatuses.GetDisplayName(topic.Status)
                                        </span>
                                    </td>
                                    <td class="text-muted">@topic.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@topic.Id" class="btn btn-outline-primary" title="Xem chi tiết" aria-label="Xem chi tiết">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            @if (topic.Status == InternshipManagement.Web.Models.TopicStatuses.Draft || topic.Status == InternshipManagement.Web.Models.TopicStatuses.RevisionRequired)
                                            {
                                                <a asp-action="Edit" asp-route-id="@topic.Id" class="btn btn-outline-warning" title="Chỉnh sửa" aria-label="Chỉnh sửa">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <form asp-action="Submit" asp-route-id="@topic.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn gửi đề tài này để cán bộ khoa xét duyệt?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-outline-success" title="Gửi xét duyệt" aria-label="Gửi xét duyệt">
                                                        <i class="bi bi-send"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <div class="p-3 d-flex justify-content-center border-top">
                        <ul class="pagination pagination-sm mb-0">
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(Model.Page == i ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-campaignId="@Model.CampaignId" asp-route-status="@Model.Status" asp-route-search="@Model.SearchQuery">@i</a>
                                </li>
                            }
                        </ul>
                    </div>
                }
            }
            else
            {
                <div class="p-5 text-center text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                    Chưa có đề tài nào phù hợp với điều kiện tìm kiếm.
                </div>
            }
        </div>
    </div>
</div>

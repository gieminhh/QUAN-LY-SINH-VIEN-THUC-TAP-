@model InternshipManagement.Web.ViewModels.Topics.TopicListViewModel

@{
    ViewData["Title"] = "Quản lý đề tài";
}

<div class="page-container">
    <!-- Tiêu đề trang -->
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h4 class="fw-bold text-primary mb-1">
                <i class="bi bi-journal-text me-2"></i>Quản lý đề tài
            </h4>
            <div class="text-muted small">
                Danh sách đề tài trong các đợt đào tạo.
            </div>
        </div>

        <div>
            <a asp-action="Create" class="btn btn-primary btn-sm px-3">
                <i class="bi bi-plus-circle me-1"></i> Tạo đề tài
            </a>
        </div>
    </div>

    <!-- Thông báo -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tìm kiếm và bộ lọc -->
    <div class="card card-custom p-3 mb-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-3">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text"
                           name="Search"
                           value="@Model.Search"
                           class="form-control"
                           placeholder="Nhập tên đề tài...">
                </div>
            </div>

            <div class="col-md-3">
                <select name="CampaignFilter" class="form-select form-select-sm">
                    <option value="">-- Tất cả đợt đào tạo --</option>
                    @foreach (var item in Model.CampaignOptions)
                    {
                        <option value="@item.Value" selected="@item.Selected">
                            @item.Text
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <select name="TypeFilter" class="form-select form-select-sm">
                    <option value="ALL" selected="@(Model.TypeFilter == "ALL")">-- Tất cả hình thức --</option>
                    <option value="INDIVIDUAL" selected="@(Model.TypeFilter == "INDIVIDUAL")">Cá nhân</option>
                    <option value="GROUP" selected="@(Model.TypeFilter == "GROUP")">Nhóm</option>
                </select>
            </div>

            <div class="col-md-2">
                <select name="StatusFilter" class="form-select form-select-sm">
                    <option value="ALL" selected="@(Model.StatusFilter == "ALL")">-- Tất cả trạng thái --</option>
                    <option value="PUBLISHED" selected="@(Model.StatusFilter == "PUBLISHED")">Đang công khai</option>
                    <option value="HIDDEN" selected="@(Model.StatusFilter == "HIDDEN")">Đang ẩn</option>
                    <option value="CLOSED" selected="@(Model.StatusFilter == "CLOSED")">Đã đóng</option>
                </select>
            </div>

            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-primary w-100" title="Áp dụng bộ lọc">
                    <i class="bi bi-funnel me-1"></i>Lọc
                </button>
                <a asp-action="Index"
                   class="btn btn-sm btn-outline-secondary"
                   title="Xóa bộ lọc">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Danh sách đề tài -->
    <div class="card card-custom">
        <div class="card-header-custom d-flex justify-content-between align-items-center">
            <span>Danh sách đề tài (@Model.TotalCount đề tài)</span>
            <span class="small text-muted">
                Trang @Model.Page / @Math.Max(1, Model.TotalPages)
            </span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th class="text-center">STT</th>
                        <th>Tên đề tài</th>
                        <th>Đợt đào tạo</th>
                        <th>Hình thức</th>
                        <th>Chỉ tiêu</th>
                        <th>Người tạo</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-end pe-3">Thao tác</th>
                    </tr>
                </thead>

                <tbody class="small">
                    @if (Model.Topics.Any())
                    {
                        var index = (Model.Page - 1) * Model.PageSize + 1;

                        @foreach (var topic in Model.Topics)
                        {
                            <tr>
                                <td class="text-center">@index</td>

                                <td>
                                    <a asp-action="Details"
                                       asp-route-id="@topic.Id"
                                       class="text-decoration-none fw-semibold text-dark">
                                        @topic.Title
                                    </a>
                                </td>

                                <td>@topic.CampaignName</td>

                                <td>
                                    @if (topic.TopicType == "INDIVIDUAL")
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary">
                                            <i class="bi bi-person me-1"></i>Cá nhân
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info bg-opacity-10 text-info border border-info">
                                            <i class="bi bi-people me-1"></i>Nhóm
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (topic.TopicType == "INDIVIDUAL")
                                    {
                                        <span>@topic.MaxStudents sinh viên</span>
                                    }
                                    else
                                    {
                                        <span>@topic.MaxGroups nhóm</span>
                                    }
                                </td>

                                <td>@topic.CreatedByName</td>

                                <td class="text-center">
                                    @if (topic.Status == "PUBLISHED")
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-eye-fill me-1"></i>Đang công khai
                                        </span>
                                    }
                                    else if (topic.Status == "HIDDEN")
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="bi bi-eye-slash-fill me-1"></i>Đang ẩn
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-lock-fill me-1"></i>Đã đóng
                                        </span>
                                    }
                                </td>

                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details"
                                           asp-route-id="@topic.Id"
                                           class="btn btn-outline-info"
                                           title="Xem chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        @if (topic.CanEdit)
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@topic.Id"
                                               class="btn btn-outline-primary"
                                               title="Chỉnh sửa đề tài">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>

                            index++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                <i class="bi bi-journal-x fs-3 d-block mb-1"></i>
                                Không tìm thấy đề tài nào trong phạm vi quản lý của bạn.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Phân trang -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-between align-items-center py-2">
                <span class="small text-muted">
                    Hiển thị @Model.Topics.Count / tổng số @Model.TotalCount đề tài
                </span>

                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-Search="@Model.Search"
                               asp-route-CampaignFilter="@Model.CampaignFilter"
                               asp-route-TypeFilter="@Model.TypeFilter"
                               asp-route-StatusFilter="@Model.StatusFilter"
                               asp-route-Page="@(Model.Page - 1)">
                                Trước
                            </a>
                        </li>

                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.Page ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-Search="@Model.Search"
                                   asp-route-CampaignFilter="@Model.CampaignFilter"
                                   asp-route-TypeFilter="@Model.TypeFilter"
                                   asp-route-StatusFilter="@Model.StatusFilter"
                                   asp-route-Page="@p">
                                    @p
                                </a>
                            </li>
                        }

                        <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-Search="@Model.Search"
                               asp-route-CampaignFilter="@Model.CampaignFilter"
                               asp-route-TypeFilter="@Model.TypeFilter"
                               asp-route-StatusFilter="@Model.StatusFilter"
                               asp-route-Page="@(Model.Page + 1)">
                                Sau
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

@model IEnumerable<InternshipManagement.Web.ViewModels.Topics.TopicListItemViewModel>

@{
    ViewData["Title"] = "Kho đề tài các khóa trước";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1">Kho đề tài các khóa trước</h3>
            <p class="text-muted mb-0">
                Danh sách đề tài thuộc các đợt đào tạo đã kết thúc.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-archive fs-1 text-muted"></i>
                    <p class="text-muted mt-3 mb-0">
                        Chưa có đề tài nào trong kho lưu trữ.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th class="text-center">STT</th>
                                <th>Tên đề tài</th>
                                <th>Đợt đào tạo</th>
                                <th>Loại đề tài</th>
                                <th>Người tạo</th>
                                <th>Ngày tạo</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int stt = 1;
                            }

                            @foreach (var topic in Model)
                            {
                                <tr>
                                    <td class="text-center">@(stt++)</td>
                                    <td>@topic.Title</td>
                                    <td>@topic.CampaignName</td>
                                    <td>
                                        @(topic.TopicType == "INDIVIDUAL"
                                            ? "Cá nhân"
                                            : "Nhóm")
                                    </td>
                                    <td>@topic.CreatedByName</td>
                                    <td>@topic.CreatedAt.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center">
                                        <a asp-action="Details"
                                           asp-route-id="@topic.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye"></i> Chi tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

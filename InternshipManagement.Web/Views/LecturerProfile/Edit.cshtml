@model InternshipManagement.Web.ViewModels.LecturerProfileEditViewModel
@{
    ViewData["Title"] = "Cập nhật hồ sơ giảng viên";
}

<div class="page-container sprint2-page">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-muted small">
            <i class="bi bi-arrow-left me-1"></i> Quay lại hồ sơ
        </a>
        <h4 class="fw-bold text-primary mt-2">
            <i class="bi bi-pencil-square me-2"></i>CẬP NHẬT THÔNG TIN CHUYÊN MÔN GIẢNG VIÊN
        </h4>
        <div class="text-muted small">Chỉnh sửa học vị, học hàm, bộ môn công tác, chuyên môn và hướng nghiên cứu</div>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card card-custom p-4 bg-light">
                <h6 class="fw-bold text-secondary border-bottom pb-2 mb-3">
                    <i class="bi bi-shield-lock me-2"></i>Thông tin định danh giảng viên
                </h6>
                <div class="small mb-3">
                    <div class="text-muted">Họ và tên:</div>
                    <div class="fw-bold text-dark">@Model.FullName</div>
                </div>
                <div class="small mb-3">
                    <div class="text-muted">Mã giảng viên:</div>
                    <div class="fw-bold text-primary">@Model.LecturerCode</div>
                </div>
                <div class="small mb-3">
                    <div class="text-muted">Khoa trực thuộc:</div>
                    <div class="fw-semibold text-dark">@Model.FacultyName</div>
                </div>
                <div class="alert alert-info small mb-0 p-2">
                    <i class="bi bi-info-circle me-1"></i>
                    Mã giảng viên, Khoa và Hạn mức hướng dẫn do ban quản trị và cán bộ đào tạo thiết lập.
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card card-custom p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="AcademicDegree" class="form-label fw-semibold"></label>
                            <input asp-for="AcademicDegree" class="form-control" placeholder="Ví dụ: Thạc sĩ, Tiến sĩ..." />
                            <span asp-validation-for="AcademicDegree" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="AcademicTitle" class="form-label fw-semibold"></label>
                            <input asp-for="AcademicTitle" class="form-control" placeholder="Ví dụ: Phó Giáo sư, Giáo sư..." />
                            <span asp-validation-for="AcademicTitle" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DepartmentName" class="form-label fw-semibold"></label>
                        <input asp-for="DepartmentName" class="form-control" placeholder="Ví dụ: Bộ môn Kỹ thuật Phần mềm, Bộ môn Hệ thống Thông tin..." />
                        <span asp-validation-for="DepartmentName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Expertise" class="form-label fw-semibold"></label>
                        <textarea asp-for="Expertise" class="form-control" rows="4" placeholder="Mô tả các lĩnh vực chuyên môn bạn đang giảng dạy và nghiên cứu sâu..."></textarea>
                        <span asp-validation-for="Expertise" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ResearchInterests" class="form-label fw-semibold"></label>
                        <textarea asp-for="ResearchInterests" class="form-control" rows="4" placeholder="Định hướng nghiên cứu khoa học, các hướng đề tài khuyến khích sinh viên thực hiện..."></textarea>
                        <span asp-validation-for="ResearchInterests" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 border-top pt-3">
                        <a asp-action="Index" class="btn btn-light px-4">Hủy bỏ</a>
                        <button type="submit" class="btn btn-usmart px-4">
                            <i class="bi bi-save me-1"></i> Lưu thông tin
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

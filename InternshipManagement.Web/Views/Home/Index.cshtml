@using InternshipManagement.Web.Models
@{
    ViewData["Title"] = "Bảng điều khiển";
    var userRoles = ViewBag.UserRoles as IList<string> ?? new List<string>();
    var isAdmin = userRoles.Contains(AppRoles.Admin);
    var isManager = isAdmin || userRoles.Contains(AppRoles.TrainingManager) || userRoles.Contains(AppRoles.FacultyManager);
    var isLecturer = userRoles.Contains(AppRoles.Lecturer);
    var isStudent = userRoles.Contains(AppRoles.Student);
    var userScopes = ViewBag.UserScopes as List<UserRoleScope> ?? new List<UserRoleScope>();
}

<div class="page-container">
    <!-- Welcome Header Banner -->
    <div class="card card-custom p-4 mb-4" style="background: linear-gradient(90deg, #f0f7ff 0%, #ffffff 100%); border-left: 4px solid #1976d2;">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h4 class="fw-bold text-primary mb-1">
                    <i class="bi bi-mortarboard-fill me-2"></i>Xin chào, @ViewBag.FullName!
                </h4>
                <div class="text-secondary small">
                    Hệ thống Quản lý Thực tập & Đồ án Sinh viên — Trường Đại học Vinh | <strong>Học kỳ 1 / Năm học 2026-2027</strong>
                </div>
            </div>
            <div>
                @foreach (var r in userRoles)
                {
                    <span class="badge bg-primary px-3 py-2 me-1">@AppRoles.GetDisplayName(r)</span>
                }
            </div>
        </div>
    </div>

    @if (userRoles.Contains(AppRoles.Company))
    {
        <div class="row g-3 mb-4">
            <div class="col-md-6"><div class="card card-custom p-4 h-100"><h5>Hồ sơ doanh nghiệp</h5><p>Gửi thông tin đăng ký hợp tác, theo dõi kết quả xét duyệt và quản lý người hướng dẫn.</p><a asp-controller="Companies" asp-action="Register" class="btn btn-primary">Xem hồ sơ doanh nghiệp</a></div></div>
            <div class="col-md-6"><div class="card card-custom p-4 h-100"><h5>Sinh viên được giao</h5><p>Tra cứu hồ sơ và CV của các sinh viên được phân công cho bạn hướng dẫn.</p><a asp-controller="Companies" asp-action="Students" class="btn btn-outline-primary">Xem sinh viên được giao</a></div></div>
        </div>
    }

    @if (isStudent)
    {
        <!-- Sinh viên Dashboard (US-07 & US-10) -->
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="card card-custom p-4 h-100">
                    <div class="d-flex align-items-start gap-3">
                        <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-3">
                            <i class="bi bi-person-vcard fs-2"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h5 class="fw-bold mb-1">Hồ sơ cá nhân & CV</h5>
                            <p class="text-muted small mb-3">Xem điểm GPA tích lũy, cập nhật kỹ năng chuyên môn, hướng nghiên cứu và tải tệp CV cá nhân.</p>
                            <a asp-controller="StudentProfile" asp-action="Index" class="btn btn-sm btn-primary">
                                <i class="bi bi-eye me-1"></i> Xem & cập nhật hồ sơ
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card card-custom p-4 h-100">
                    <div class="d-flex align-items-start gap-3">
                        <div class="bg-success bg-opacity-10 text-success p-3 rounded-3">
                            <i class="bi bi-journal-check fs-2"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h5 class="fw-bold mb-1">Đề tài được phê duyệt</h5>
                            <p class="text-muted small mb-3">Hiện có <strong>@(ViewBag.ApprovedTopicsCount ?? 0)</strong> đề tài đã được hội đồng khoa phê duyệt chính thức.</p>
                            <a asp-controller="Topics" asp-action="Approved" class="btn btn-sm btn-success">
                                <i class="bi bi-search me-1"></i> Tra cứu danh mục đề tài
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (isLecturer)
    {
        <!-- Giảng viên Dashboard (US-08 & US-10) -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card card-custom p-3 h-100">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small fw-semibold">ĐỀ TÀI CỦA TÔI</div>
                            <h3 class="fw-bold mb-0 text-dark">@(ViewBag.MyTopicsCount ?? 0)</h3>
                        </div>
                        <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle">
                            <i class="bi bi-journal-text fs-4"></i>
                        </div>
                    </div>
                    <div class="mt-2 pt-2 border-top small">
                        <a asp-controller="Topics" asp-action="Index" class="text-decoration-none text-primary">
                            Xem tất cả đề tài <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card card-custom p-3 h-100">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small fw-semibold">ĐỀ TÀI ĐÃ ĐƯỢC DUYỆT</div>
                            <h3 class="fw-bold mb-0 text-success">@(ViewBag.MyApprovedTopicsCount ?? 0)</h3>
                        </div>
                        <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle">
                            <i class="bi bi-check-circle fs-4"></i>
                        </div>
                    </div>
                    <div class="mt-2 pt-2 border-top small">
                        <a asp-controller="Topics" asp-action="Index" asp-route-status="APPROVED" class="text-decoration-none text-success">
                            Xem đề tài đã duyệt <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card card-custom p-3 h-100">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small fw-semibold">HỒ SƠ GIẢNG VIÊN</div>
                            <h5 class="fw-bold mb-0 text-dark">Chuyên môn & Hướng NC</h5>
                        </div>
                        <div class="bg-info bg-opacity-10 text-info p-3 rounded-circle">
                            <i class="bi bi-person-badge fs-4"></i>
                        </div>
                    </div>
                    <div class="mt-2 pt-2 border-top small">
                        <a asp-controller="LecturerProfile" asp-action="Index" class="text-decoration-none text-info">
                            Xem hồ sơ cá nhân <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="card card-custom mb-4">
            <div class="card-header-custom d-flex justify-content-between align-items-center">
                <span><i class="bi bi-lightning-charge me-2"></i>Thao tác giảng viên</span>
            </div>
            <div class="card-body p-3">
                <div class="row g-2">
                    <div class="col-md-6">
                        <a asp-controller="Topics" asp-action="Create" class="btn btn-outline-primary w-100 p-3 text-start d-flex align-items-center">
                            <i class="bi bi-plus-circle fs-2 me-3 text-primary"></i>
                            <div>
                                <div class="fw-bold">Đăng ký đề tài mới</div>
                                <small class="text-muted">Tạo bản nháp hoặc gửi đề tài xét duyệt đến cán bộ khoa</small>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-6">
                        <a asp-controller="LecturerProfile" asp-action="Edit" class="btn btn-outline-secondary w-100 p-3 text-start d-flex align-items-center">
                            <i class="bi bi-pencil-square fs-2 me-3 text-secondary"></i>
                            <div>
                                <div class="fw-bold">Cập nhật thông tin chuyên môn</div>
                                <small class="text-muted">Bổ sung học hàm, học vị, hướng nghiên cứu</small>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (isManager)
    {
        <!-- Quick Stat Cards cho Cán bộ & Admin -->
        <div class="row g-3 mb-4">
            @if (isAdmin)
            {
                <div class="col-sm-6 col-lg-3">
                    <div class="card card-custom p-3 h-100">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <div class="text-muted small fw-semibold">TỔNG TÀI KHOẢN</div>
                                <h3 class="fw-bold mb-0 text-dark">@ViewBag.TotalUsers</h3>
                            </div>
                            <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle">
                                <i class="bi bi-people-fill fs-4"></i>
                            </div>
                        </div>
                        <div class="mt-2 pt-2 border-top small">
                            <a asp-controller="Users" asp-action="Index" class="text-decoration-none text-primary">
                                Quản lý tài khoản <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }

            <div class="col-sm-6 col-lg-3">
                <div class="card card-custom p-3 h-100">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small fw-semibold">ĐỀ TÀI CHỜ XÉT DUYỆT</div>
                            <h3 class="fw-bold mb-0 text-warning">@(ViewBag.PendingTopicsCount ?? 0)</h3>
                        </div>
                        <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-circle">
                            <i class="bi bi-hourglass-split fs-4"></i>
                        </div>
                    </div>
                    <div class="mt-2 pt-2 border-top small">
                        <a asp-controller="TopicApproval" asp-action="Index" class="text-decoration-none text-warning text-dark">
                            Xét duyệt ngay <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-3">
                <div class="card card-custom p-3 h-100">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small fw-semibold">ĐỢT ĐANG MỞ</div>
                            <h3 class="fw-bold mb-0 text-success">@ViewBag.OpenCampaigns</h3>
                        </div>
                        <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle">
                            <i class="bi bi-calendar2-range-fill fs-4"></i>
                        </div>
                    </div>
                    <div class="mt-2 pt-2 border-top small">
                        <a asp-controller="Campaigns" asp-action="Index" asp-route-statusFilter="OPEN" class="text-decoration-none text-success">
                            Xem đợt đang mở <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-3">
                <div class="card card-custom p-3 h-100">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small fw-semibold">ĐỀ TÀI ĐÃ PHÊ DUYỆT</div>
                            <h3 class="fw-bold mb-0 text-info">@(ViewBag.ApprovedTopicsCount ?? 0)</h3>
                        </div>
                        <div class="bg-info bg-opacity-10 text-info p-3 rounded-circle">
                            <i class="bi bi-check2-all fs-4"></i>
                        </div>
                    </div>
                    <div class="mt-2 pt-2 border-top small">
                        <a asp-controller="Topics" asp-action="Approved" class="text-decoration-none text-info">
                            Xem đề tài đã duyệt <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- User's Scopes Info Box (US-03) -->
        <div class="card card-custom mb-4">
            <div class="card-header-custom d-flex justify-content-between align-items-center">
                <span><i class="bi bi-shield-lock me-2"></i>Phạm vi phân quyền quản lý của bạn (user_role_scopes)</span>
                @if (isAdmin)
                {
                    <span class="badge bg-danger">Toàn quyền hệ thống</span>
                }
            </div>
            <div class="card-body p-3">
                @if (userScopes.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Vai trò</th>
                                    <th>Loại phạm vi</th>
                                    <th>Mục tiêu ủy quyền</th>
                                    <th>Thời gian cấp</th>
                                </tr>
                            </thead>
                            <tbody class="small">
                                @foreach (var s in userScopes)
                                {
                                    <tr>
                                        <td><span class="badge bg-secondary">@AppRoles.GetDisplayName(s.Role?.Name ?? s.RoleId)</span></td>
                                        <td><span class="badge bg-primary">@ScopeTypes.GetDisplayName(s.ScopeType)</span></td>
                                        <td>
                                            @if (s.ScopeType == ScopeTypes.Global)
                                            {
                                                <span class="text-success fw-bold"><i class="bi bi-globe me-1"></i>Toàn trường</span>
                                            }
                                            else if (s.ScopeType == ScopeTypes.Faculty)
                                            {
                                                <span><i class="bi bi-building me-1"></i>Khoa: @(s.Faculty?.Name ?? s.FacultyId.ToString())</span>
                                            }
                                            else if (s.ScopeType == ScopeTypes.Major)
                                            {
                                                <span><i class="bi bi-journal-bookmark me-1"></i>Ngành: @(s.Major?.Name ?? s.MajorId.ToString())</span>
                                            }
                                            else if (s.ScopeType == ScopeTypes.Campaign)
                                            {
                                                <span><i class="bi bi-calendar-event me-1"></i>Đợt: @(s.Campaign?.Name ?? s.CampaignId.ToString())</span>
                                            }
                                        </td>
                                        <td class="text-muted">@s.GrantedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-muted small py-2">
                        <i class="bi bi-info-circle me-1"></i>
                        @(isAdmin ? "Tài khoản Quản trị viên mặc định có quyền toàn hệ thống." : "Tài khoản chưa được cấp phạm vi quản lý.")
                    </div>
                }
            </div>
        </div>

        <!-- Thao tác nhanh cho Cán bộ / Admin -->
        <div class="card card-custom mb-4">
            <div class="card-header-custom">
                <i class="bi bi-grid-3x3-gap-fill me-2"></i>Thao tác nhanh
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-3">
                        <a asp-controller="TopicApproval" asp-action="Index" class="btn btn-outline-warning w-100 p-3 text-start d-flex align-items-center h-100">
                            <i class="bi bi-check2-square fs-2 me-3 text-warning"></i>
                            <div>
                                <div class="fw-bold">Xét duyệt đề tài</div>
                                <small class="text-muted">Phê duyệt, yêu cầu sửa, từ chối</small>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-3">
                        <a asp-controller="LecturerQuotas" asp-action="Index" class="btn btn-outline-info w-100 p-3 text-start d-flex align-items-center h-100">
                            <i class="bi bi-sliders fs-2 me-3 text-info"></i>
                            <div>
                                <div class="fw-bold">Hạn mức giảng viên</div>
                                <small class="text-muted">Phân bổ chỉ tiêu SV theo đợt</small>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-3">
                        <a asp-controller="Campaigns" asp-action="Index" class="btn btn-outline-success w-100 p-3 text-start d-flex align-items-center h-100">
                            <i class="bi bi-calendar-check fs-2 me-3 text-success"></i>
                            <div>
                                <div class="fw-bold">Quản lý các đợt</div>
                                <small class="text-muted">Xem, lọc và cập nhật đợt</small>
                            </div>
                        </a>
                    </div>
                    @if (isAdmin)
                    {
                        <div class="col-md-3">
                            <a asp-controller="Users" asp-action="Index" class="btn btn-outline-primary w-100 p-3 text-start d-flex align-items-center h-100">
                                <i class="bi bi-people fs-2 me-3 text-primary"></i>
                                <div>
                                    <div class="fw-bold">Quản lý tài khoản</div>
                                    <small class="text-muted">Thêm, sửa & phân quyền</small>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

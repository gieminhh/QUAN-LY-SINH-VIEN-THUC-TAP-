
@model InternshipManagement.Web.ViewModels.AcademicYears.AcademicYearCreateEditViewModel

@{
    ViewData["Title"] = "Thêm năm học mới";
}

<div class="page-container">
    <div class="mb-3">
        <h4 class="fw-bold text-primary mb-1">
            <i class="bi bi-plus-circle me-2"></i>Thêm năm học mới
        </h4>
        <div class="text-muted small">
            Nhập thông tin năm học cần thêm vào hệ thống
        </div>
    </div>

    <div class="card card-custom">
        <div class="card-header-custom">
            Thông tin năm học
        </div>

        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Code" class="form-label fw-semibold"></label>
                    <input asp-for="Code" class="form-control"
                           placeholder="Ví dụ: 2026-2027">
                    <span asp-validation-for="Code" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="StartDate" class="form-label fw-semibold"></label>
                    <input asp-for="StartDate" type="date" class="form-control">
                    <span asp-validation-for="StartDate" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EndDate" class="form-label fw-semibold"></label>
                    <input asp-for="EndDate" type="date" class="form-control">
                    <span asp-validation-for="EndDate" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary btn-sm px-3">
                        <i class="bi bi-check-circle me-1"></i> Lưu năm học
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


@model InternshipManagement.Web.ViewModels.AcademicYears.AcademicYearListViewModel

@{
    ViewData["Title"] = "Quản lý năm học";
}

<div class="page-container">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h4 class="fw-bold text-primary mb-1">
                <i class="bi bi-calendar3 me-2"></i>Quản lý năm học
            </h4>
            <div class="text-muted small">
                Quản lý danh sách năm học và thời gian đào tạo
            </div>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-sm px-3">
            <i class="bi bi-plus-circle me-1"></i> Thêm năm học mới
        </a>
    </div>

    <!-- Search -->
    <div class="card card-custom p-3 mb-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="search" class="form-control"
                           placeholder="Tìm theo mã năm học..."
                           value="@Model.Search">
                </div>
            </div>

            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-primary w-100" title="Tìm kiếm">
                    <i class="bi bi-search"></i>
                </button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Xóa tìm kiếm">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Academic Year Table -->
    <div class="card card-custom">
        <div class="card-header-custom d-flex justify-content-between align-items-center">
            <span>Danh sách năm học (@Model.TotalCount năm học)</span>
            <span class="small text-muted">
                Trang @Model.Page / @Math.Max(1, Model.TotalPages)
            </span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Mã năm học</th>
                        <th>Ngày bắt đầu</th>
                        <th>Ngày kết thúc</th>
                        <th class="text-center">Thời gian</th>
                        <th class="text-end pe-3">Thao tác</th>
                    </tr>
                </thead>

                <tbody class="small">
                    @if (Model.AcademicYears.Any())
                    {
                        @foreach (var y in Model.AcademicYears)
                        {
                            <tr>
                                <td>
                                    <span class="fw-bold font-monospace text-primary">
                                        @y.Code
                                    </span>
                                </td>
                                <td>@y.StartDate.ToString("dd/MM/yyyy")</td>
                                <td>@y.EndDate.ToString("dd/MM/yyyy")</td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">
                                        @((y.EndDate - y.StartDate).Days + 1) ngày
                                    </span>
                                </td>
                                <td class="text-end pe-3">
                                    <a asp-action="Edit" asp-route-id="@y.Id"
                                       class="btn btn-sm btn-outline-primary"
                                       title="Chỉnh sửa">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                <i class="bi bi-calendar-x fs-3 d-block mb-1"></i>
                                Không tìm thấy năm học nào phù hợp.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-between align-items-center py-2">
                <span class="small text-muted">
                    Hiển thị @Model.AcademicYears.Count / tổng số @Model.TotalCount năm học
                </span>

                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@(Model.Page - 1)"
                               asp-route-search="@Model.Search">Trước</a>
                        </li>

                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.Page ? "active" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-page="@p"
                                   asp-route-search="@Model.Search">@p</a>
                            </li>
                        }

                        <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@(Model.Page + 1)"
                               asp-route-search="@Model.Search">Sau</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

@model InternshipManagement.Web.ViewModels.CampaignRulesViewModel
@{ ViewData["Title"] = "Lịch và điều kiện tham gia"; }
@using InternshipManagement.Web.Services
<div class="page-container backlog-page"><h4 class="fw-bold text-primary">Lịch và điều kiện tham gia đợt</h4><form method="get" class="mb-3"><label>Đợt</label><select name="campaignId" class="form-select">@foreach(var c in Model.Campaigns){<option value="@c.Id" selected="@(c.Id==Model.Campaign.Id)">@c.Name</option>}</select><button class="btn btn-primary mt-2">Chọn đợt</button></form><p>Thời gian theo giờ Việt Nam. Đợt: @Model.Campaign.StartDate.ToString("dd/MM/yyyy") — @Model.Campaign.EndDate.ToString("dd/MM/yyyy").</p>
<div class="card card-custom p-3 mb-3"><h5>Các giai đoạn</h5>@foreach(var stage in CampaignRulesService.Stages){var w=Model.Windows.FirstOrDefault(x=>x.Stage==stage);var label=stage switch{"REGISTRATION"=>"Đăng ký / đề xuất đề tài","MATCHING"=>"Phân công / ghép","SUBMISSION"=>"Nộp báo cáo",_=>"Đánh giá"};<form asp-action="SaveWindow" method="post" class="row g-2 border-bottom py-3">@Html.AntiForgeryToken()<input name="campaignId" value="@Model.Campaign.Id" type="hidden"/><input name="stage" value="@stage" type="hidden"/><div class="col-md-3">@label</div><div class="col-md-3"><label>Mở lúc</label><input name="opensAt" type="datetime-local" value="@w?.OpensAt.ToString("yyyy-MM-ddTHH:mm")" class="form-control" required/></div><div class="col-md-3"><label>Đóng lúc</label><input name="closesAt" type="datetime-local" value="@w?.ClosesAt.ToString("yyyy-MM-ddTHH:mm")" class="form-control" required/></div><div class="col-md-3"><button class="btn btn-outline-primary">Lưu giai đoạn</button></div></form>}</div>
<form asp-action="SavePolicy" method="post" class="card card-custom p-3 mb-3">@Html.AntiForgeryToken()<input name="campaignId" value="@Model.Campaign.Id" type="hidden"/><h5>Điều kiện tham gia</h5><p>Để trống điều kiện chưa áp dụng. Không tự lấy GPA làm tiêu chí nếu chưa cấu hình.</p><label>GPA tối thiểu thang 4</label><input name="minimumGpa4" value="@Model.Policy.MinimumGpa4?.ToString(System.Globalization.CultureInfo.InvariantCulture)" type="number" step="0.01" min="0" max="4" class="form-control"/><label>GPA tối thiểu thang 10</label><input name="minimumGpa10" value="@Model.Policy.MinimumGpa10?.ToString(System.Globalization.CultureInfo.InvariantCulture)" type="number" step="0.01" min="0" max="10" class="form-control"/><label>Tín chỉ tối thiểu</label><input name="minimumCredits" value="@Model.Policy.MinimumCredits" type="number" min="0" max="500" class="form-control"/><label>Điều kiện tiên quyết cần xác nhận</label><textarea name="prerequisiteNote" maxlength="1000" class="form-control">@Model.Policy.PrerequisiteNote</textarea><button class="btn btn-primary mt-2">Lưu điều kiện</button></form>
<div class="card card-custom p-3 mb-3"><h5>Sinh viên đủ / chưa đủ điều kiện</h5><a asp-route-campaignId="@Model.Campaign.Id">Tất cả</a><a asp-route-campaignId="@Model.Campaign.Id" asp-route-eligibility="eligible">Đủ điều kiện</a><a asp-route-campaignId="@Model.Campaign.Id" asp-route-eligibility="ineligible">Chưa đủ / thiếu minh chứng</a>@foreach(var s in Model.Students){<div class="border-bottom py-3"><strong>@s.Code — @s.Name</strong><p>@(s.Error??"Đủ điều kiện")</p><form asp-action="SaveEvidence" method="post">@Html.AntiForgeryToken()<input name="campaignId" value="@Model.Campaign.Id" type="hidden"/><input name="studentId" value="@s.Id" type="hidden"/><label>Số tín chỉ đã xác minh</label><input name="credits" type="number" min="0" max="500" required class="form-control"/><label><input name="prerequisitesMet" type="checkbox" value="true"/> Đã đạt tiên quyết</label><input name="sourceNote" placeholder="Nguồn minh chứng học vụ / người xác nhận" maxlength="1000" required class="form-control"/><button class="btn btn-sm btn-outline-primary mt-2">Lưu minh chứng</button></form></div>}</div>
<div class="card card-custom p-3"><h5>Ngoại lệ thời hạn được duyệt</h5><form asp-action="GrantException" method="post">@Html.AntiForgeryToken()<input name="campaignId" value="@Model.Campaign.Id" type="hidden"/><label>Tài khoản được cấp ngoại lệ</label><select name="userId" asp-items="Model.ExceptionUsers" class="form-select" required><option value="">Chọn tài khoản</option></select><label>Giai đoạn</label><select name="stage" class="form-select">@foreach(var s in CampaignRulesService.Stages){<option value="@s">@(s switch {"REGISTRATION"=>"Đăng ký / đề xuất đề tài","MATCHING"=>"Phân công / ghép","SUBMISSION"=>"Nộp báo cáo",_=>"Đánh giá"})</option>}</select><label>Hiệu lực đến (giờ Việt Nam)</label><input name="expiresAt" type="datetime-local" required class="form-control"/><label>Lý do phê duyệt</label><textarea name="reason" required maxlength="1000" class="form-control"></textarea><button class="btn btn-primary mt-2">Phê duyệt ngoại lệ</button></form>@foreach(var e in Model.Exceptions){<p>@e.UserId — @e.Stage — @e.ExpiresAt — @e.Reason (người duyệt: @e.ApprovedBy)</p><form asp-action="RevokeException" method="post">@Html.AntiForgeryToken()<input name="id" value="@e.Id" type="hidden"/><button class="btn btn-sm btn-outline-danger">Thu hồi</button></form>}</div></div>

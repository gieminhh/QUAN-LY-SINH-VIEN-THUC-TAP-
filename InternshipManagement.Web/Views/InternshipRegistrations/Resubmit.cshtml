@model InternshipManagement.Web.ViewModels.InternshipRegistrations.InternshipRegistrationFormViewModel

@{
    ViewData["Title"] = "Chỉnh sửa và nộp lại đăng ký thực tập";
}

<div class="page-container">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h4 class="fw-bold text-primary mb-1">Chỉnh sửa và nộp lại đăng ký thực tập</h4>
            <div class="text-muted small">Đợt: <strong>@Model.CampaignName</strong></div>
        </div>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Quay lại chi tiết
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.PreviousRejectionReason))
    {
        <div class="alert alert-danger">
            <div class="fw-semibold mb-1"><i class="bi bi-exclamation-circle me-1"></i>Lý do từ chối lần trước</div>
            <div>@Model.PreviousRejectionReason</div>
        </div>
    }

    <div class="card card-custom">
        <div class="card-header-custom">Cập nhật thông tin hồ sơ</div>
        <div class="card-body">
            <form asp-action="Resubmit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label class="form-label fw-semibold d-block">Cách chọn nơi thực tập</label>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="PlaceMode" id="modeExisting"
                               value="EXISTING" @(Model.PlaceMode != "NEW" ? "checked" : "") onchange="togglePlaceMode()">
                        <label class="form-check-label" for="modeExisting">Chọn nơi thực tập có sẵn</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="PlaceMode" id="modeNew"
                               value="NEW" @(Model.PlaceMode == "NEW" ? "checked" : "") onchange="togglePlaceMode()">
                        <label class="form-check-label" for="modeNew">Tự nhập nơi thực tập mới</label>
                    </div>
                </div>

                <div id="existingPlaceSection" class="mb-3">
                    <label asp-for="ExistingPlaceId" class="form-label fw-semibold"></label>
                    <select asp-for="ExistingPlaceId" asp-items="Model.ExistingPlaceOptions" class="form-select">
                        <option value="">-- Chọn nơi thực tập --</option>
                    </select>
                    <span asp-validation-for="ExistingPlaceId" class="text-danger small"></span>
                </div>

                <div id="newPlaceSection" class="border rounded p-3 bg-light mb-3" style="display:none;">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="NewPlaceName" class="form-label fw-semibold"></label>
                            <input asp-for="NewPlaceName" class="form-control" />
                            <span asp-validation-for="NewPlaceName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="NewPlaceAddress" class="form-label fw-semibold"></label>
                            <input asp-for="NewPlaceAddress" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="NewPlaceContactPerson" class="form-label fw-semibold"></label>
                            <input asp-for="NewPlaceContactPerson" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="NewPlaceContactPhone" class="form-label fw-semibold"></label>
                            <input asp-for="NewPlaceContactPhone" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="NewPlaceContactEmail" class="form-label fw-semibold"></label>
                            <input asp-for="NewPlaceContactEmail" class="form-control" />
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label asp-for="PositionTitle" class="form-label fw-semibold"></label>
                        <input asp-for="PositionTitle" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="StartDate" class="form-label fw-semibold"></label>
                        <input asp-for="StartDate" type="date" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="EndDate" class="form-label fw-semibold"></label>
                        <input asp-for="EndDate" type="date" class="form-control" />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Note" class="form-label fw-semibold"></label>
                    <textarea asp-for="Note" class="form-control" rows="3"></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmationFile" class="form-label fw-semibold"></label>
                    <input asp-for="ConfirmationFile" type="file" class="form-control" />
                    @if (!string.IsNullOrWhiteSpace(Model.ExistingOriginalFileName))
                    {
                        <div class="form-text">Tệp hiện tại: <strong>@Model.ExistingOriginalFileName</strong> (để trống nếu giữ nguyên tệp cũ).</div>
                    }
                    <span asp-validation-for="ConfirmationFile" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-arrow-repeat me-1"></i>Gửi lại hồ sơ xét duyệt
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function togglePlaceMode() {
            const isNew = document.getElementById('modeNew')?.checked;
            document.getElementById('newPlaceSection').style.display = isNew ? 'block' : 'none';
            document.getElementById('existingPlaceSection').style.display = isNew ? 'none' : 'block';
        }
        document.addEventListener('DOMContentLoaded', togglePlaceMode);
    </script>
}
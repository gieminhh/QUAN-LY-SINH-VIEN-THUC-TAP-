@model InternshipManagement.Web.ViewModels.StudentProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân sinh viên";
}

<div class="page-container">
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <div>
            <h4 class="fw-bold text-primary mb-1">
                <i class="bi bi-person-vcard me-2"></i>HỒ SƠ CÁ NHÂN SINH VIÊN
            </h4>
            <div class="text-muted small">Quản lý thông tin học vụ, kỹ năng chuyên môn và CV đính kèm</div>
        </div>
        @if (Model.CanEdit)
        {
            <a asp-action="Edit" class="btn btn-usmart">
                <i class="bi bi-pencil-square me-1"></i> Cập nhật hồ sơ & CV
            </a>
        }
    </div>

    <div class="row g-4">
        <!-- Cột trái: Thông tin cá nhân & Học vụ -->
        <div class="col-lg-4">
            <div class="card card-custom mb-4">
                <div class="card-body text-center p-4">
                    <div class="mb-3">
                        <i class="bi bi-person-circle text-primary" style="font-size: 5rem;"></i>
                    </div>
                    <h5 class="fw-bold mb-1">@Model.FullName</h5>
                    <div class="text-primary fw-semibold mb-2">Mã SV: @Model.StudentCode</div>
                    <span class="badge bg-primary px-3 py-2 mb-3">Sinh viên</span>

                    <div class="text-start border-top pt-3 small">
                        <div class="mb-2">
                            <span class="text-muted"><i class="bi bi-envelope me-2"></i>Email:</span>
                            <span class="fw-semibold">@Model.Email</span>
                        </div>
                        <div class="mb-2">
                            <span class="text-muted"><i class="bi bi-people me-2"></i>Lớp:</span>
                            <span class="fw-semibold">@Model.ClassName</span>
                        </div>
                        <div class="mb-2">
                            <span class="text-muted"><i class="bi bi-mortarboard me-2"></i>Ngành:</span>
                            <span class="fw-semibold">@Model.MajorName</span>
                        </div>
                        <div class="mb-2">
                            <span class="text-muted"><i class="bi bi-building me-2"></i>Khoa:</span>
                            <span class="fw-semibold">@Model.FacultyName</span>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Cohort))
                        {
                            <div class="mb-2">
                                <span class="text-muted"><i class="bi bi-calendar3 me-2"></i>Khóa:</span>
                                <span class="fw-semibold">@Model.Cohort</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Thống kê điểm GPA chính thức -->
            <div class="card card-custom">
                <div class="card-header-custom">
                    <i class="bi bi-trophy me-2"></i>Điểm trung bình tích lũy (GPA)
                </div>
                <div class="card-body p-3">
                    <div class="row text-center g-2 mb-3">
                        <div class="col-6">
                            <div class="p-2 border rounded bg-light">
                                <small class="text-muted d-block">Thang 4</small>
                                <span class="fs-4 fw-bold text-primary">
                                    @(Model.LatestGpa4.HasValue ? Model.LatestGpa4.Value.ToString("F2") : "--")
                                </span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2 border rounded bg-light">
                                <small class="text-muted d-block">Thang 10</small>
                                <span class="fs-4 fw-bold text-success">
                                    @(Model.LatestGpa10.HasValue ? Model.LatestGpa10.Value.ToString("F2") : "--")
                                </span>
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.LatestTermName))
                    {
                        <div class="text-center small text-muted mb-2">
                            Áp dụng từ: <strong>@Model.LatestTermName</strong>
                        </div>
                    }

                    @if (Model.GpaHistory.Any())
                    {
                        <div class="border-top pt-2">
                            <small class="fw-bold text-muted d-block mb-1">Lịch sử điểm theo học kỳ:</small>
                            <table class="table table-sm table-bordered small text-center mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Học kỳ</th>
                                        <th>Thang 4</th>
                                        <th>Thang 10</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var gpa in Model.GpaHistory)
                                    {
                                        <tr>
                                            <td>HK@(gpa.Term?.TermNo) (@(gpa.Term?.AcademicYear?.Code))</td>
                                            <td class="fw-semibold text-primary">@gpa.Gpa4?.ToString("F2")</td>
                                            <td class="fw-semibold text-success">@gpa.Gpa10?.ToString("F2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-0 text-center">Chưa có bản ghi GPA nào được cập nhật.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Cột phải: Kỹ năng, Lĩnh vực quan tâm, CV đính kèm -->
        <div class="col-lg-8">
            <!-- Kỹ năng chuyên môn -->
            <div class="card card-custom mb-4">
                <div class="card-header-custom d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-tools me-2"></i>Kỹ năng chuyên môn</span>
                    @if (Model.CanEdit)
                    {
                        <a asp-action="Edit" class="btn btn-sm btn-outline-primary py-0 px-2" style="font-size: 11px;">
                            <i class="bi bi-pencil"></i> Chỉnh sửa
                        </a>
                    }
                </div>
                <div class="card-body p-4">
                    @if (!string.IsNullOrWhiteSpace(Model.Skills))
                    {
                        <p class="mb-0 text-dark" style="white-space: pre-line;">@Model.Skills</p>
                    }
                    else
                    {
                        <div class="text-muted fst-italic">
                            Chưa cập nhật kỹ năng chuyên môn. Nhấn <strong>"Cập nhật hồ sơ & CV"</strong> để bổ sung thông tin (ví dụ: C#, ASP.NET, Java, React, SQL Server...).
                        </div>
                    }
                </div>
            </div>

            <!-- Lĩnh vực quan tâm -->
            <div class="card card-custom mb-4">
                <div class="card-header-custom d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-stars me-2"></i>Lĩnh vực quan tâm / Hướng nghiên cứu</span>
                    @if (Model.CanEdit)
                    {
                        <a asp-action="Edit" class="btn btn-sm btn-outline-primary py-0 px-2" style="font-size: 11px;">
                            <i class="bi bi-pencil"></i> Chỉnh sửa
                        </a>
                    }
                </div>
                <div class="card-body p-4">
                    @if (!string.IsNullOrWhiteSpace(Model.Interests))
                    {
                        <p class="mb-0 text-dark" style="white-space: pre-line;">@Model.Interests</p>
                    }
                    else
                    {
                        <div class="text-muted fst-italic">
                            Chưa cập nhật lĩnh vực quan tâm. Ví dụ: Phát triển ứng dụng Web, Xử lý ảnh số, Trí tuệ nhân tạo, An toàn thông tin...
                        </div>
                    }
                </div>
            </div>

            <!-- CV đính kèm -->
            <div class="card card-custom mb-4">
                <div class="card-header-custom">
                    <i class="bi bi-file-earmark-person me-2"></i>CV cá nhân đính kèm
                </div>
                <div class="card-body p-4">
                    @if (Model.CvAttachment != null)
                    {
                        <div class="d-flex align-items-center justify-content-between p-3 border rounded bg-light">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-primary bg-opacity-10 text-primary p-3 rounded">
                                    <i class="bi bi-file-earmark-pdf fs-3"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark">@Model.CvAttachment.OriginalFileName</div>
                                    <div class="text-muted small">
                                        Dung lượng: @((Model.CvAttachment.SizeBytes / 1024.0).ToString("N1")) KB | 
                                        Cập nhật: @Model.CvAttachment.UploadedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                <a asp-action="DownloadCv" asp-route-attachmentId="@Model.CvAttachment.Id" class="btn btn-sm btn-primary">
                                    <i class="bi bi-download me-1"></i> Tải xuống CV
                                </a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">
                            <i class="bi bi-info-circle me-2"></i>
                            Bạn chưa tải lên CV cá nhân. Hãy tải lên tệp tin định dạng <strong>PDF, DOC, DOCX</strong> để giảng viên và hội đồng có thể tham khảo khi xét duyệt và phân công đề tài.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

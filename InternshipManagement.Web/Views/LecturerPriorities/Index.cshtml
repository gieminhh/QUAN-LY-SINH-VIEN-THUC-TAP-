@model RankingPage
@{ ViewData["Title"] = "Ưu tiên sinh viên"; var choices = Model.Input.StudentIds.Count > 0 ? Model.Input.StudentIds : new List<string>{ "" }; }
<h3>Giảng viên xếp hạng ưu tiên sinh viên</h3>
<form method="get" class="d-flex gap-2 mb-3"><select class="form-select" name="topicId" aria-label="Đề tài">@foreach(var t in Model.Topics) { <option value="@t.Id" selected="@(t.Id == Model.Input.TopicId)">@t.Title</option> }</select><button class="btn btn-outline-primary">Xem đề tài</button></form>
<p>Chỉ có sinh viên cùng ngành đã chọn đề tài. Thứ tự do giảng viên quyết định; GPA không tự quyết định ưu tiên. Ghi rõ tiêu chí để phục vụ kiểm tra và giải trình.</p>
@if(Model.Input.TopicId != 0) {
@if(Model.SavedAt != null) { <p>Lần lưu cuối: @Model.SavedAt.Value.AddHours(7).ToString("dd/MM/yyyy HH:mm:ss") (giờ Việt Nam)</p> }
@if(Model.LockedReason != null) {
<p class="alert alert-info">@Model.LockedReason</p><p>Tiêu chí: @Model.Input.Reason</p>
<ol>@foreach(var id in Model.Input.StudentIds) { <li>@(Model.Candidates.FirstOrDefault(u => u.Id == id)?.FullName ?? "Sinh viên không còn trong danh sách hợp lệ")</li> }</ol>
} else {
<form asp-action="Save" method="post" class="card p-3">
<div asp-validation-summary="All" class="text-danger"></div><input type="hidden" asp-for="Input.TopicId" /><input type="hidden" asp-for="Input.Version" />
<label asp-for="Input.Reason">Tiêu chí / lý do ưu tiên</label><textarea class="form-control mb-3" asp-for="Input.Reason" maxlength="1000" required></textarea>
<ol id="priority-rows">@foreach(var id in choices) { <li class="mb-2"><div class="d-flex gap-2"><select class="form-select" name="Input.StudentIds" aria-label="Sinh viên ưu tiên"><option value="">Bỏ trống để không xếp hạng</option>@foreach(var u in Model.Candidates) { <option value="@u.Id" selected="@(u.Id == id)">@u.FullName (@u.UserName)</option> }</select><button type="button" class="btn btn-outline-secondary" data-up>Lên</button><button type="button" class="btn btn-outline-secondary" data-down>Xuống</button><button type="button" class="btn btn-outline-danger" data-remove>Bỏ</button></div></li> }</ol>
<button type="button" class="btn btn-outline-primary mb-2" id="add-priority">Thêm nguyện vọng ưu tiên</button><button class="btn btn-primary">Lưu thứ tự ưu tiên</button>
</form>
}
} else { <p>Chưa có đề tài bạn phụ trách.</p> }
@section Scripts {
<script>
(() => {
const list = document.getElementById('priority-rows'); if (!list) return;
const template = list.firstElementChild.cloneNode(true); template.querySelector('select').value = '';
const add = document.getElementById('add-priority');
const update = () => { add.disabled = list.children.length >= @Model.Candidates.Count; [...list.querySelectorAll('select')].forEach((s,i) => s.setAttribute('aria-label','Ưu tiên '+(i+1))); };
add.addEventListener('click', () => { list.append(template.cloneNode(true)); update(); });
list.addEventListener('click', e => { const row = e.target.closest('li'); if (!row) return; if (e.target.closest('[data-up]') && row.previousElementSibling) list.insertBefore(row,row.previousElementSibling); if (e.target.closest('[data-down]') && row.nextElementSibling) list.insertBefore(row.nextElementSibling,row); if (e.target.closest('[data-remove]')) row.remove(); update(); });
update();
})();
</script>
}
